<UserControl
    x:Class="CloudInlet.Views.ExclusionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CloudInlet.Views"
    xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">
    <UserControl.Resources>
        <Style x:Key="ExclusionSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="ExclusionSecondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ExclusionTokenSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="EditorRoot" Spacing="16">
        <Grid x:Name="ExclusionHeader" ColumnSpacing="16" RowSpacing="16" SizeChanged="ExclusionHeader_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="ExclusionIntroduction" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Excluded files and folders" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Excluded files stay on your device. Existing cloud copies are kept." TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="1" MinHeight="36" VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Add exclusion">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Width="14" Height="14" />
                    <TextBlock Text="Add exclusion" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Choose files" Click="AddFiles_Click"><MenuFlyoutItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=document, Size=24}"  Width="24" Height="24" Tag="document" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Choose a folder" Click="AddFolder_Click"><MenuFlyoutItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=24}"  Width="24" Height="24" Tag="folder" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="File type" Click="AddType_Click"><MenuFlyoutItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=document, Size=24}"  Width="24" Height="24" Tag="document" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Name rule" Click="AddName_Click"><MenuFlyoutItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=filter, Size=24}"  Width="24" Height="24" Tag="filter" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Advanced pattern" Click="AddAdvanced_Click">
                            <MenuFlyoutItem.Icon>
                                <AnimatedIcon Width="24" Height="24">
                                    <AnimatedIcon.Source><animated:AnimatedSettingsVisualSource /></AnimatedIcon.Source>
                                    <AnimatedIcon.FallbackIconSource><FontIconSource Glyph="&#xE713;" /></AnimatedIcon.FallbackIconSource>
                                </AnimatedIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" Visibility="Collapsed" />
        <Border x:Name="EmptyPanel" Style="{StaticResource ExclusionSurface}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=28}" VerticalAlignment="Top" Margin="0,4,0,0"  Width="28" Height="28" Tag="folder" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Everything is included" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Add a file, folder, file type, or name rule to skip it during backup and sync." Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel x:Name="RulesPanel" Spacing="6" />
        <Border x:Name="BuilderPanel" Style="{StaticResource ExclusionSurface}" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BuilderTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
                    <TextBlock x:Name="BuilderHelp" Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
                <StackPanel x:Name="SelectionPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <Button x:Name="ChangeSelectionButton" Content="Choose again" Click="ChangeSelection_Click" HorizontalAlignment="Left" MinHeight="36" />
                </StackPanel>
                <StackPanel x:Name="TypePanel" Spacing="16" Visibility="Collapsed">
                    <TextBox x:Name="ExtensionBox" Header="File extension" PlaceholderText="For example, jpg" TextChanged="Draft_TextChanged" MaxLength="128" />
                    <Button x:Name="ExampleFileButton" Content="Choose an example file" Click="ExampleFile_Click" HorizontalAlignment="Left" MinHeight="36" />
                    <TextBlock Text="The rule applies to files with this extension, wherever they are in the selected scope." Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
                <StackPanel x:Name="NamePanel" Spacing="16" Visibility="Collapsed">
                    <Grid ColumnSpacing="16" SizeChanged="FieldPair_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ComboBox x:Name="NameMatchBox" Header="Match names that" SelectedIndex="0" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Are exactly" /><ComboBoxItem Content="Contain" /><ComboBoxItem Content="Start with" /><ComboBoxItem Content="End with" />
                        </ComboBox>
                        <TextBox x:Name="NameBox" Grid.Column="1" Header="Name or text" PlaceholderText="For example, cache" TextChanged="Draft_TextChanged" MaxLength="255" />
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="AdvancedPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Build the pattern from left to right. Each part can be moved or removed." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel x:Name="TokensPanel" Spacing="8" />
                    <TextBox x:Name="LiteralBox" Header="Literal text" PlaceholderText="A folder name, file name, or part of a name" MaxLength="255" />
                    <Button Content="Add text" Click="AddLiteral_Click" HorizontalAlignment="Left" MinHeight="36" />
                    <Button Content="Add matching part" HorizontalAlignment="Left" MinHeight="36">
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Any text within a name (*)" Tag="text" Click="AddToken_Click" />
                            <MenuFlyoutItem Text="One character within a name (?)" Tag="character" Click="AddToken_Click" />
                            <MenuFlyoutItem Text="Any number of subfolders (**)" Tag="subfolders" Click="AddToken_Click" />
                            <MenuFlyoutItem Text="Folder separator (/)" Tag="separator" Click="AddToken_Click" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <TextBlock Text="Any text and one character stay within a name. Any number of subfolders is a complete path part, separated by folder separators." Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
                <StackPanel x:Name="ScopePanel" Spacing="16">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="Where to apply it" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                    <Grid ColumnSpacing="16" SizeChanged="FieldPair_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ComboBox x:Name="TargetBox" Header="Exclude matching" SelectedIndex="0" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Files" /><ComboBoxItem Content="Folders and everything inside" /><ComboBoxItem Content="Files and folders" />
                        </ComboBox>
                        <ComboBox x:Name="ScopeBox" Grid.Column="1" Header="Apply to" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Button x:Name="ScopeFolderButton" Content="Choose a specific folder" Click="ScopeFolder_Click" HorizontalAlignment="Left" MinHeight="36" />
                    <TextBlock x:Name="ScopeFolderSummary" Style="{StaticResource ExclusionSecondary}" Visibility="Collapsed" />
                </StackPanel>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Rule preview" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" />
                        <TextBlock x:Name="PreviewSummary" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="PreviewPattern" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ExclusionSecondary}" />
                    </StackPanel>
                </Border>
                <InfoBar x:Name="BuilderError" IsOpen="False" IsClosable="False" Severity="Error" Visibility="Collapsed" />
                <Expander x:Name="TestPanel" Header="Try a name or path" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16" Padding="4,8,4,12">
                        <TextBox x:Name="TestPathBox" Header="Path inside the selected scope" PlaceholderText="For example, Projects/cache/report.txt" TextChanged="Draft_TextChanged" />
                        <ComboBox x:Name="TestKindBox" Header="This is a" SelectedIndex="0" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="File" /><ComboBoxItem Content="Folder" /></ComboBox>
                        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                </Expander>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel x:Name="BuilderActions" Orientation="Horizontal" Spacing="12" SizeChanged="BuilderActions_SizeChanged">
                    <Button x:Name="SaveButton" Content="Save exclusion" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" MinHeight="36" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinHeight="36" />
                    <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
