<UserControl
    x:Class="CloudInlet.Views.ExclusionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ExclusionSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="ExclusionSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ExclusionTokenSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="EditorRoot" Spacing="16" Margin="0,16,0,0">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Choose what CloudInlet skips. Excluded files stay on your device; existing cloud copies are kept." TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="1" Content="Add exclusion" VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Choose files" Click="AddFiles_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Choose a folder" Click="AddFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="File type" Click="AddType_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Name rule" Click="AddName_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Advanced pattern" Click="AddAdvanced_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" Visibility="Collapsed" />
        <Border x:Name="EmptyPanel" Style="{StaticResource ExclusionSurface}">
            <StackPanel Spacing="8"><TextBlock Text="Everything is included" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="Add a file, folder, file type, or a name rule to skip it during backup and sync." Style="{StaticResource ExclusionSecondary}" /></StackPanel>
        </Border>
        <StackPanel x:Name="RulesPanel" Spacing="8" />
        <Border x:Name="BuilderPanel" Style="{StaticResource ExclusionSurface}" Visibility="Collapsed">
            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="BuilderTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="BuilderHelp" Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
                <StackPanel x:Name="SelectionPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <Button x:Name="ChangeSelectionButton" Content="Choose again" Click="ChangeSelection_Click" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="TypePanel" Spacing="12" Visibility="Collapsed">
                    <TextBox x:Name="ExtensionBox" Header="File extension" PlaceholderText="For example, jpg" TextChanged="Draft_TextChanged" MaxLength="128" />
                    <Button x:Name="ExampleFileButton" Content="Choose an example file" Click="ExampleFile_Click" HorizontalAlignment="Left" />
                    <TextBlock Text="The rule applies to files with this extension, wherever they are in the selected scope." Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
                <StackPanel x:Name="NamePanel" Spacing="12" Visibility="Collapsed">
                    <ComboBox x:Name="NameMatchBox" Header="Match names that" SelectedIndex="0" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Are exactly" /><ComboBoxItem Content="Contain" /><ComboBoxItem Content="Start with" /><ComboBoxItem Content="End with" />
                    </ComboBox>
                    <TextBox x:Name="NameBox" Header="Name or text" PlaceholderText="For example, cache" TextChanged="Draft_TextChanged" MaxLength="255" />
                </StackPanel>
                <StackPanel x:Name="AdvancedPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Build the pattern from left to right. Each part can be moved or removed." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel x:Name="TokensPanel" Spacing="6" />
                    <TextBox x:Name="LiteralBox" Header="Literal text" PlaceholderText="A folder name, file name, or part of a name" MaxLength="255" />
                    <Button Content="Add text" Click="AddLiteral_Click" HorizontalAlignment="Left" />
                    <Button Content="Add matching part" HorizontalAlignment="Left">
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Any text within a name (*)" Tag="text" Click="AddToken_Click" />
                            <MenuFlyoutItem Text="One character within a name (?)" Tag="character" Click="AddToken_Click" />
                            <MenuFlyoutItem Text="Any number of subfolders (**)" Tag="subfolders" Click="AddToken_Click" />
                            <MenuFlyoutItem Text="Folder separator (/)" Tag="separator" Click="AddToken_Click" />
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <TextBlock Text="Any text and one character stay within a name. Any number of subfolders is a complete path part, separated by folder separators." Style="{StaticResource ExclusionSecondary}" />
                </StackPanel>
                <StackPanel x:Name="ScopePanel" Spacing="12">
                    <ComboBox x:Name="TargetBox" Header="Exclude matching" SelectedIndex="0" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Files" /><ComboBoxItem Content="Folders and everything inside" /><ComboBoxItem Content="Files and folders" />
                    </ComboBox>
                    <ComboBox x:Name="ScopeBox" Header="Apply to" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch" />
                    <Button x:Name="ScopeFolderButton" Content="Choose a specific folder" Click="ScopeFolder_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ScopeFolderSummary" Style="{StaticResource ExclusionSecondary}" Visibility="Collapsed" />
                </StackPanel>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="PreviewSummary" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="PreviewPattern" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ExclusionSecondary}" />
                    </StackPanel>
                </Border>
                <InfoBar x:Name="BuilderError" IsOpen="False" IsClosable="False" Severity="Error" Visibility="Collapsed" />
                <Expander x:Name="TestPanel" Header="Try a name or path" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="TestPathBox" Header="Path inside the selected scope" PlaceholderText="For example, Projects/cache/report.txt" TextChanged="Draft_TextChanged" />
                        <ComboBox x:Name="TestKindBox" Header="This is a" SelectedIndex="0" SelectionChanged="Draft_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="File" /><ComboBoxItem Content="Folder" /></ComboBox>
                        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveButton" Content="Save exclusion" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
                    <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
