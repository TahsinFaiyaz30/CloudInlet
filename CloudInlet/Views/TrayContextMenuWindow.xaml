<Window
    x:Class="CloudInlet.Views.TrayContextMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <!-- Keep the stock Fluent menu templates, theme colors and peers.
         This presenter is the entire window: no activity/main window underneath. -->
    <Grid x:Name="MenuRoot" Background="Transparent">
        <Grid.Resources>
            <!-- Bitmap captures cannot include the window's compositor Acrylic. -->
            <Style x:Key="MenuCaptureSurfaceStyle" TargetType="MenuFlyoutPresenter"
                   BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </Grid.Resources>
        <MenuFlyoutPresenter
            x:Name="MenuPresenter"
            MinWidth="272"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            TabFocusNavigation="Cycle"
            AutomationProperties.Name="CloudInlet tray menu"
            PreviewKeyDown="MenuPresenter_PreviewKeyDown" />
    </Grid>
</Window>
