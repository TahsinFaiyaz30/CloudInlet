                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="FilePathBox"
                                                            Header="File in this folder"
                                                            PlaceholderText="Select a file or enter its relative path" />
