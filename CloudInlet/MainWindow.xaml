                                                                            Grid.Column="1"
                                                                            Text="{Binding Size}"
                                                                            Style="{StaticResource CloudInletSecondaryTextStyle}"
                                                                            VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
