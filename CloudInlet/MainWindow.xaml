                                                               Tag="general" Click="SettingsCategory_Click" Style="{StaticResource CloudInletCategoryStyle}">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=power, Size=24}"  Width="24" Height="24" Tag="power" /></settings:SettingsCard.HeaderIcon>
                                        </settings:SettingsCard>
                                        <settings:SettingsCard x:Name="AppearanceCategory" Header="Appearance" Description="Make CloudInlet feel at home on your desktop."
                                                               Tag="appearance" Click="SettingsCategory_Click" Style="{StaticResource CloudInletCategoryStyle}">
