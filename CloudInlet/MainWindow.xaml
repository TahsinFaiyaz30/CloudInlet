<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:CloudInlet.Views"
    xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    x:Class="CloudInlet.MainWindow">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Grid.Resources>
            <!-- Recycled rows bind native glyphs directly. Replacing bitmap
                 IconSource instances during virtualization can fail in WinUI. -->
            <DataTemplate x:Key="TransferActivityRowTemplate">
                <Border Style="{StaticResource CloudInletSurfaceStyle}" Padding="20,16">
                    <Grid ColumnSpacing="16" Loaded="ActivityRow_Loaded" SizeChanged="ActivityRow_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="20" Height="20" />
                        <StackPanel x:Name="ActivityDetails" Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="ActivityFileName" Text="{Binding FileName}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Location}" />
                            <TextBlock Text="{Binding Location}" Style="{StaticResource CloudInletSecondaryTextStyle}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Location}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,6,0,0">
                            <TextBlock x:Name="ActivityFileStatus" Text="{Binding StatusLine}" TextWrapping="Wrap"
                                       Style="{StaticResource CloudInletSecondaryTextStyle}"
                                       ToolTipService.ToolTip="{Binding TimeFullText}" />
                            <ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}"
                                         Visibility="{Binding ProgressVisibility}" AutomationProperties.Name="{Binding ProgressAccessibleName}" />
                            <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                                       Style="{StaticResource CloudInletSecondaryTextStyle}" />
                        </StackPanel>
                        <views:ActionWrapPanel x:Name="ActivityActions" Grid.Column="2" Spacing="8" VerticalAlignment="Center"
                                               SizeChanged="ActivityActions_SizeChanged">
                            <Button x:Name="ActivityOpenFolder" MinWidth="132" MinHeight="36" Padding="12,6"
                                    Visibility="{Binding Actions.OpenFolderVisibility}" ToolTipService.ToolTip="{Binding Actions.OpenFolderToolTip}"
                                    AutomationProperties.Name="Open activity folder" Click="ActivityOpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock Text="Open folder" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ActivityViewCloud" MinWidth="132" MinHeight="36" Padding="12,6"
                                    Visibility="{Binding Actions.CloudVisibility}" ToolTipService.ToolTip="{Binding Actions.CloudToolTip}"
                                    AutomationProperties.Name="View activity file versions in Backblaze B2" Click="ActivityViewCloud_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE753;" FontSize="16" /><TextBlock Text="View in cloud" />
                                </StackPanel>
                            </Button>
                        </views:ActionWrapPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="CloudInlet" MinHeight="48"
                  IsBackButtonVisible="True" IsBackButtonEnabled="False" BackRequested="ShellBackRequested"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="ShellPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/CloudInlet-32.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="NavigationSearch" Width="440" MaxWidth="520"
                                PlaceholderText="Search CloudInlet" QueryIcon="Find"
                                AutomationProperties.Name="Search pages and settings"
                                UpdateTextOnSelect="False" TextMemberPath="Title" MaxSuggestionListHeight="480"
                                GotFocus="NavigationSearch_GotFocus"
                                TextChanged="NavigationSearch_TextChanged" QuerySubmitted="NavigationSearch_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="20" Height="20" VerticalAlignment="Center"
                                          Glyph="{Binding Glyph}" FontSize="20" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Title}" />
                                <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="272"
            CompactPaneLength="56"
            CompactModeThresholdWidth="641"
            ExpandedModeThresholdWidth="1120"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            AlwaysShowHeader="False"
            SelectionChanged="Navigation_SelectionChanged"
            ItemInvoked="Navigation_ItemInvoked"
            Background="Transparent">
            <NavigationView.Resources>
                <!-- Native Windows layering: a quiet commanding layer over
                     Mica Alt, followed by one continuous content surface. -->
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
                <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">8,0,0,0</CornerRadius>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home"  Tag="overview" Style="{StaticResource CloudInletNavigationItemStyle}">
                    <NavigationViewItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=home, Size=24}" Width="24" Height="24" Tag="home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity"  Tag="activity" Style="{StaticResource CloudInletNavigationItemStyle}">
                    <NavigationViewItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=history, Size=24}" Width="24" Height="24" Tag="history" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Folder backup"  Tag="backup" Style="{StaticResource CloudInletNavigationItemStyle}">
                    <NavigationViewItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=24}" Width="24" Height="24" Tag="folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Files"  Tag="files" Style="{StaticResource CloudInletNavigationItemStyle}">
                    <NavigationViewItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=document, Size=24}" Width="24" Height="24" Tag="document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServicesNavigationItem" Content="Cloud services" Tag="services" Style="{StaticResource CloudInletNavigationItemStyle}">
                    <NavigationViewItem.Icon><IconSourceElement IconSource="{views:FluentIcon Kind=cloud, Size=24}"  Width="24" Height="24" Tag="cloud" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Border x:Name="NavigationStatusCard" Margin="20,12,20,20" Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastSyncLabel}" Style="{StaticResource CloudInletSecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <Grid x:Name="ContentLayoutGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="PageHeader" MaxWidth="1240" HorizontalAlignment="Center" Margin="8,0,12,0" Padding="28,24,28,16">
                    <StackPanel Spacing="8">
                        <BreadcrumbBar x:Name="PageBreadcrumb" Visibility="Collapsed"
                                       ItemClicked="PageBreadcrumb_ItemClicked" AutomationProperties.Name="Page navigation">
                            <BreadcrumbBar.Resources>
                                <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                                <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                                <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                                <Thickness x:Key="BreadcrumbBarChevronPadding">8,0</Thickness>
                                <StaticResource x:Key="BreadcrumbBarNormalForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                            </BreadcrumbBar.Resources>
                            <BreadcrumbBar.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>
                        <TextBlock
                            x:Name="PageTitle"
                            Text="Home"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextWrapping="Wrap"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock
                            x:Name="PageDescription"
                            Style="{StaticResource CloudInletBodySecondaryTextStyle}"
                            Visibility="Collapsed" />
                        <InfoBar x:Name="TransferConnectionBanner" Severity="Informational" IsClosable="False" Visibility="Collapsed"
                                 Title="Transfer draft saved" Message="Connect the service, then return to finish choosing your locations.">
                            <InfoBar.Content>
                                <views:ActionWrapPanel x:Name="TransferConnectionActions" Spacing="8" Margin="0,0,16,16">
                                    <Button Content="Return to transfer" HorizontalAlignment="Left" Click="ReturnToTransfer_Click" />
                                    <Button Content="Cancel transfer setup" HorizontalAlignment="Left" Click="CancelTransferSetup_Click" />
                                </views:ActionWrapPanel>
                            </InfoBar.Content>
                        </InfoBar>
                        <TextBlock
                            x:Name="ActivityPending"
                            Text="{Binding ActivityStatusSummary}"
                            Style="{StaticResource CloudInletSecondaryTextStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="StorageSummary"
                            Text="{Binding StorageSummary}"
                            Style="{StaticResource CloudInletSecondaryTextStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <InfoBar
                    x:Name="StatusInfoBar"
                    Grid.Row="1"
                    Margin="36,0,40,12"
                    MaxWidth="1184" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch"
                    IsOpen="False"
                    Visibility="Collapsed"
                    Closed="StatusInfoBar_Closed"
                    IsClosable="True" />
                <Grid x:Name="ForegroundLayout" Grid.Row="2" Margin="8,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        x:Name="OverviewPage"
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="OverviewContent" Style="{StaticResource CloudInletPageContentStyle}">
                            <Border x:Name="WelcomePanel">
                                <StackPanel Spacing="20">
                                    <TextBlock Text="Start with your cloud" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="Choose a service below. Your connection options depend on what each provider supports."
                                               Style="{StaticResource CloudInletBodySecondaryTextStyle}" Margin="0,-8,0,0" />
                                    <ContentControl x:Name="HomeServicesHost" HorizontalContentAlignment="Stretch" />
                                    <Button x:Name="ConnectAccountButton" Content="Explore all cloud services" Tag="services" Click="QuickNavigate_Click"
                                            Style="{StaticResource SubtleButtonStyle}" MinHeight="36" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="ConnectedOverview" Spacing="24" Visibility="Collapsed">
                                <Border
                                    CornerRadius="8"
                                    Padding="24"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="20">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="64" Height="64" VerticalAlignment="Top">
                                                <IconSourceElement
                                                    IconSource="{views:FluentIcon Kind=cloud, Size=56}"  Width="56" Height="56" Tag="cloud" />
                                                <Border
                                                    VerticalAlignment="Bottom"
                                                    Height="20"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    Width="20"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="10">
                                                    <IconSourceElement
                                                        IconSource="{Binding StatusGlyph, Converter={StaticResource FluentGlyphConverter}, ConverterParameter=12}"

                                                        x:Name="OverviewStatusIcon"  Width="12" Height="12" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="{Binding StatusTitle}"
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    x:Name="OverviewStatusDetail"
                                                    Text="{Binding StatusDescription}"
                                                    Style="{StaticResource CloudInletBodySecondaryTextStyle}" />
                                                <TextBlock
                                                    x:Name="OverviewLastSync"
                                                    Text="{Binding LastSyncLabel}"
                                                    ToolTipService.ToolTip="{Binding LastSyncFullLabel}"
                                                    Style="{StaticResource CloudInletSecondaryTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="TransferProgressPanel" Spacing="8" Visibility="Collapsed">
                                            <ProgressBar
                                                x:Name="TransferProgress"
                                                Value="{Binding Progress}"
                                                Maximum="100"
                                                AutomationProperties.Name="{Binding ProgressLabel}" />
                                            <TextBlock
                                                x:Name="TransferProgressDetail"
                                                Text="{Binding ProgressLabel}"
                                                Style="{StaticResource CloudInletSecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <views:ActionWrapPanel x:Name="DashboardActions" Spacing="8">
                                            <Button
                                                x:Name="ReviewDeletionsButton"
                                                Content="Review pending deletions"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="Collapsed"
                                                Click="ReviewDeletions_Click"
                                                MinHeight="36" />
                                            <Button
                                                x:Name="OpenFolderButton"
                                                Content="Open folder"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OpenFolder_Click"
                                                MinHeight="36" />
                                            <Button
                                                x:Name="SyncNowButton"
                                                Content="Sync now"
                                                Click="SyncNow_Click"
                                                MinHeight="36" />
                                            <Button
                                                x:Name="DashboardPauseButton"
                                                Content="{Binding PauseLabel}"
                                                Click="Pause_Click"
                                                MinHeight="36" />
                                        </views:ActionWrapPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="BackupSuggestion" Spacing="12" Visibility="Collapsed">
                                    <settings:SettingsCard
                                        Header="Choose folders to back up"
                                        Description="Protect your Windows folders and other personal folders."
                                        IsClickEnabled="True"
                                        Click="ManageBackup_Click"
                                        MinHeight="76">
                                        <settings:SettingsCard.HeaderIcon>
                                            <IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=24}"  Width="24" Height="24" Tag="folder" />
                                        </settings:SettingsCard.HeaderIcon>
                                    </settings:SettingsCard>
                                </StackPanel>
                                <Grid x:Name="OverviewSections" ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="ProtectedFoldersSection" Spacing="12" Visibility="Collapsed">
                                        <Border
                                            Style="{StaticResource CloudInletSurfaceStyle}"
                                            x:Name="ProtectedFolderSurface">
                                            <StackPanel Spacing="16">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="Backed-up folders"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CloudInletSectionHeadingStyle}" />
                                                    <HyperlinkButton
                                                        Grid.Column="1"
                                                        Content="Manage"
                                                        VerticalAlignment="Center"
                                                        Padding="0"
                                                        Click="ManageBackup_Click" />
                                                </Grid>
                                                <Grid x:Name="ProtectedFolderRows" ColumnSpacing="8" RowSpacing="8" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="RecentActivitySection"
                                        Spacing="12"
                                        Visibility="Collapsed"
                                        Grid.Column="1">
                                        <Border Style="{StaticResource CloudInletSurfaceStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="Recent activity"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CloudInletSectionHeadingStyle}" />
                                                    <HyperlinkButton
                                                        Grid.Column="1"
                                                        Content="View all"
                                                        VerticalAlignment="Center"
                                                        Padding="0"
                                                        Click="ViewActivity_Click" />
                                                </Grid>
                                                <ItemsControl
                                                    ItemsSource="{Binding RecentActivity}"
                                                    ItemTemplate="{StaticResource ActivityTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="16">
                                <TextBlock Text="Quick access" Style="{StaticResource CloudInletSectionHeadingStyle}" />
                                <Grid x:Name="HomeQuickActions" ColumnSpacing="16" RowSpacing="16">
                                    <settings:SettingsCard Header="Folder backup" Description="Choose the folders you want to protect."
                                                           Style="{StaticResource CloudInletCategoryStyle}" Click="ManageBackup_Click">
                                        <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=24}"  Width="24" Height="24" Tag="folder" /></settings:SettingsCard.HeaderIcon>
                                    </settings:SettingsCard>
                                    <settings:SettingsCard x:Name="HomeCloudTransferCard" Header="Transfer between clouds" Description="Copy or move files between OneDrive, B2, and this PC."
                                                           Style="{StaticResource CloudInletCategoryStyle}" Click="CloudTransfer_Click">
                                        <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=sync, Size=24}"  Width="24" Height="24" Tag="sync" /></settings:SettingsCard.HeaderIcon>
                                    </settings:SettingsCard>
                                    <settings:SettingsCard Header="Your files" Description="Open folders, manage space, and restore versions."
                                                           Style="{StaticResource CloudInletCategoryStyle}" Tag="files" Click="QuickNavigate_Click">
                                        <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=document, Size=24}"  Width="24" Height="24" Tag="document" /></settings:SettingsCard.HeaderIcon>
                                    </settings:SettingsCard>
                                    <settings:SettingsCard Header="Cloud services" Description="Choose your provider and see what is coming next."
                                                           Style="{StaticResource CloudInletCategoryStyle}" Tag="services" Click="QuickNavigate_Click">
                                        <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=cloud, Size=24}"  Width="24" Height="24" Tag="cloud" /></settings:SettingsCard.HeaderIcon>
                                    </settings:SettingsCard>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid
                        x:Name="ActivityPage"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        MaxWidth="1240"
                        HorizontalAlignment="Center"
                        Padding="{StaticResource CloudInletPageInset}">
                        <Grid RowSpacing="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="12">
                                <Grid x:Name="ActivityToolbar" ColumnSpacing="16" RowSpacing="12" SizeChanged="ActivityToolbar_SizeChanged">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="ActivityToolbarTitle" Text="Transfers and history" VerticalAlignment="Center" Style="{StaticResource CloudInletSectionHeadingStyle}" />
                                    <Button x:Name="CloudTransferAction" Grid.Column="1" Content="New cloud transfer" Click="CloudTransfer_Click"
                                            MinHeight="36" Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <ScrollViewer x:Name="CloudTransferJobsPanel" MaxHeight="320" Visibility="Collapsed"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="CloudTransferJobRows" Spacing="12" />
                                </ScrollViewer>
                                <ComboBox x:Name="ActivityFilterBox" Width="200" HorizontalAlignment="Left" SelectedIndex="0"
                                          AutomationProperties.Name="Activity filter" SelectionChanged="ActivityFilter_SelectionChanged">
                                    <ComboBoxItem Content="All activity" Tag="All" />
                                    <ComboBoxItem Content="In progress" Tag="Active" />
                                    <ComboBoxItem Content="Queued" Tag="Queue" />
                                    <ComboBoxItem Content="History" Tag="History" />
                                </ComboBox>
                                <TextBlock x:Name="ActivityQueueCoverage" Text="{Binding QueueCoverage}"
                                           Style="{StaticResource CloudInletSecondaryTextStyle}" Visibility="Collapsed" />
                            </StackPanel>
                            <ListView
                                x:Name="ActivityList"
                                Grid.Row="1"
                                ItemsSource="{Binding ActivityRows}"
                                ItemTemplate="{StaticResource TransferActivityRowTemplate}"
                                ItemContainerStyle="{StaticResource CloudInletListItemStyle}"
                                SelectionMode="None"
                                HorizontalContentAlignment="Stretch" />
                            <StackPanel
                                x:Name="ActivityEmpty"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                                <IconSourceElement
                                    IconSource="{views:FluentIcon Kind=clock, Size=48}"  Width="48" Height="48" Tag="clock" />
                                <TextBlock
                                    Text="{Binding ActivityEmptyMessage}"
                                    Style="{StaticResource CloudInletSecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ScrollViewer
                        x:Name="BackupPage"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="BackupContent" Style="{StaticResource CloudInletPageContentStyle}">
                            <InfoBar
                                x:Name="BackupConnectInfo"
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Message="Choose a cloud service to start. Folder backup is currently available with Backblaze B2.">
                                <InfoBar.ActionButton>
                                    <Button Content="Choose service" Tag="services" Click="QuickNavigate_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Windows folders" Style="{StaticResource CloudInletSectionHeadingStyle}" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="MoreWindowsFolders" Grid.Column="1" Content="Show all folders"
                                                  Checked="MoreWindowsFolders_Toggled" Unchecked="MoreWindowsFolders_Toggled"
                                                  AutomationProperties.Name="Show all Windows folders" MinHeight="32" />
                                </Grid>
                                <Grid ColumnSpacing="12" RowSpacing="12" x:Name="BackupRows" />
                                <Grid ColumnSpacing="12" RowSpacing="12" x:Name="MoreBackupRows" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="CloudImportSection" Spacing="12" Visibility="Collapsed">
                                <TextBlock Text="Bring in a cloud folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose an entire cloud folder. You'll review the source and destination before any files are copied."
                                           Style="{StaticResource CloudInletSecondaryTextStyle}" />
                                <Grid x:Name="CloudImportRows" ColumnSpacing="12" RowSpacing="12" />
                            </StackPanel>
                            <StackPanel x:Name="CustomBackupSection" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Other folders" Style="{StaticResource CloudInletSectionHeadingStyle}" />
                                <Grid ColumnSpacing="12" RowSpacing="12" x:Name="CustomBackupRows" />
                            </StackPanel>
                            <settings:SettingsExpander
                                x:Name="CustomBackupExpander"
                                Header="Add another folder"
                                Description="Back up a personal folder from its current location.">
                                <settings:SettingsExpander.HeaderIcon>
                                    <IconSourceElement IconSource="{views:FluentIcon Kind=add, Size=24}"  Width="24" Height="24" Tag="add" />
                                </settings:SettingsExpander.HeaderIcon>
                                <settings:SettingsExpander.Items>
                                    <settings:SettingsCard
                                        ContentAlignment="Vertical"
                                        HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="CustomBackupSourceBox"
                                                    Header="Folder"
                                                    PlaceholderText="Choose a folder" />
                                                <Button
