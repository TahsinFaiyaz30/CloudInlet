                                                Click="SyncSettings_Click"
                                                HorizontalAlignment="Left"
                                                Padding="0" />
                                        </StackPanel>
                                    </settings:SettingsCard>
                                </settings:SettingsExpander.Items>
                            </settings:SettingsExpander>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="FilesPage"
