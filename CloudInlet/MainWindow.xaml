                                                               Tag="about" Click="SettingsCategory_Click" Style="{StaticResource CloudInletCategoryStyle}">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=info, Size=24}"  Width="24" Height="24" Tag="info" /></settings:SettingsCard.HeaderIcon>
                                        </settings:SettingsCard>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="SettingsDetail" Spacing="24" Visibility="Collapsed">
