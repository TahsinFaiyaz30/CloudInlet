                                                               Tag="network" Click="SettingsCategory_Click" Style="{StaticResource CloudInletCategoryStyle}">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=sync, Size=24}"  Width="24" Height="24" Tag="sync" /></settings:SettingsCard.HeaderIcon>
                                        </settings:SettingsCard>
                                        <settings:SettingsCard x:Name="CatalogCategory" Header="Backup capabilities" Description="Explore native backup providers and planned connection modes."
                                                               Tag="catalog" Click="SettingsCategory_Click" Style="{StaticResource CloudInletCategoryStyle}">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=globe, Size=24}"  Width="24" Height="24" Tag="globe" /></settings:SettingsCard.HeaderIcon>
                                        </settings:SettingsCard>
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Your app" Margin="0,0,0,4" Style="{StaticResource CloudInletSectionHeadingStyle}" />
