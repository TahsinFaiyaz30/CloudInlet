                                                    AutomationProperties.Name="Apply transfer settings" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Pause automatically" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                        <Grid x:Name="NetworkPauseGrid" ColumnSpacing="12" RowSpacing="12" Tag="2" SizeChanged="SettingsDetailGrid_SizeChanged">
                                            <Grid.Resources>
                                                <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                                <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <settings:SettingsCard Header="Metered connections" Description="Pause syncing to limit mobile data use.">
                                                <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=globe, Size=24}"  Width="24" Height="24" Tag="globe" /></settings:SettingsCard.HeaderIcon>
                                                <ToggleSwitch x:Name="MeteredBox" Style="{StaticResource CloudInletToggleStyle}"
                                                              AutomationProperties.Name="Pause on metered connections" Toggled="Preference_Toggled" />
                                            </settings:SettingsCard>
                                            <settings:SettingsCard Grid.Column="1" Header="Battery Saver" Description="Pause syncing to save battery power.">
                                                <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=battery, Size=24}"  Width="24" Height="24" Tag="battery" /></settings:SettingsCard.HeaderIcon>
                                                <ToggleSwitch x:Name="BatterySaverBox" Style="{StaticResource CloudInletToggleStyle}"
                                                              AutomationProperties.Name="Pause with Battery Saver" Toggled="Preference_Toggled" />
                                            </settings:SettingsCard>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="AppearanceSettingsDetail" Spacing="24" Visibility="Collapsed" Loaded="AppearanceSettings_Loaded">
                                    <StackPanel.Resources>
                                        <DataTemplate x:Key="AppearanceWindowPreview">
                                            <Border Height="124" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                                <Grid RowSpacing="0">
                                                    <Grid.RowDefinitions><RowDefinition Height="23" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid Grid.ColumnSpan="2" Padding="8,0" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <IconSourceElement IconSource="{views:FluentIcon Kind=cloud, Size=10}"  Width="10" Height="10" Tag="cloud" />
                                                        <Border Grid.Column="1" Width="44" Height="3" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="1" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE8BB;" FontSize="6" />
                                                    </Grid>
                                                    <StackPanel Grid.Row="1" Spacing="10" Padding="5,8">
                                                        <Border Height="17" CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                            <Grid><Border Width="2" Height="10" HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1" /><IconSourceElement IconSource="{views:FluentIcon Kind=home, Size=10}"   Width="10" Height="10" Tag="home" /></Grid>
                                                        </Border>
                                                        <IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=10}"  Width="10" Height="10" Tag="folder" />
                                                        <IconSourceElement IconSource="{views:FluentIcon Kind=settings, Size=10}"  Width="10" Height="10" Tag="settings" />
                                                    </StackPanel>
                                                    <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="6,0,0,0" Padding="10">
                                                        <StackPanel Spacing="7">
                                                            <Border Width="46" Height="5" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorPrimaryBrush}" CornerRadius="2" Margin="0,1,0,3" />
                                                            <Border Height="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="7,0">
                                                                <Grid><Border Width="34" Height="3" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="1" /><Border Width="19" Height="10" HorizontalAlignment="Right" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="5" /></Grid>
                                                            </Border>
                                                            <Border Height="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="7,0">
                                                                <Grid><Border Width="26" Height="3" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="1" /><FontIcon Glyph="&#xE76C;" FontSize="7" HorizontalAlignment="Right" /></Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </StackPanel.Resources>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Choose your look" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                        <TextBlock Text="Make CloudInlet feel at home on your PC." Style="{StaticResource CloudInletBodySecondaryTextStyle}" />
                                    </StackPanel>
                                    <Grid x:Name="ThemeChoiceGrid" ColumnSpacing="12" RowSpacing="12" SizeChanged="ThemeChoices_SizeChanged">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="SystemThemeChoice" Tag="System" Click="ThemeChoice_Click" CornerRadius="8" Padding="14"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Use Windows system theme">
                                            <StackPanel Spacing="12">
                                                <ContentControl x:Name="SystemThemePreview" Content="System" ContentTemplate="{StaticResource AppearanceWindowPreview}" HorizontalContentAlignment="Stretch" IsHitTestVisible="False" IsTabStop="False" />
                                                <StackPanel Spacing="4"><TextBlock Text="System" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="Follow Windows" FontSize="12" Opacity="0.8" TextWrapping="Wrap" /></StackPanel>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="LightThemeChoice" Grid.Column="1" Tag="Light" Click="ThemeChoice_Click" CornerRadius="8" Padding="14"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Use light theme">
                                            <StackPanel Spacing="12">
                                                <ContentControl Content="Light" RequestedTheme="Light" ContentTemplate="{StaticResource AppearanceWindowPreview}" HorizontalContentAlignment="Stretch" IsHitTestVisible="False" IsTabStop="False" />
                                                <StackPanel Spacing="4"><TextBlock Text="Light" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="A brighter workspace" FontSize="12" Opacity="0.8" TextWrapping="Wrap" /></StackPanel>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="DarkThemeChoice" Grid.Column="2" Tag="Dark" Click="ThemeChoice_Click" CornerRadius="8" Padding="14"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Use dark theme">
                                            <StackPanel Spacing="12">
                                                <ContentControl Content="Dark" RequestedTheme="Dark" ContentTemplate="{StaticResource AppearanceWindowPreview}" HorizontalContentAlignment="Stretch" IsHitTestVisible="False" IsTabStop="False" />
                                                <StackPanel Spacing="4"><TextBlock Text="Dark" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="A darker workspace" FontSize="12" Opacity="0.8" TextWrapping="Wrap" /></StackPanel>
                                            </StackPanel>
                                        </ToggleButton>
                                    </Grid>
                                    <!-- Keep the established preference and rollback path as the single source of truth. -->
                                    <ComboBox x:Name="ThemeBox" Visibility="Collapsed" SelectionChanged="Theme_SelectionChanged">
                                        <ComboBoxItem Content="Use system setting" Tag="System" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                    </ComboBox>
                                    <StackPanel Spacing="12" Margin="0,8,0,0">
                                        <TextBlock Text="Personalize in Windows" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                        <settings:SettingsCard Header="Accent color and transparency" Description="CloudInlet follows your Windows accent color and accessibility preferences." IsClickEnabled="True" Click="WindowsAppearance_Click">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=paint-brush, Size=24}"  Width="24" Height="24" Tag="paint-brush" /></settings:SettingsCard.HeaderIcon>
                                            <settings:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></settings:SettingsCard.ActionIcon>
                                        </settings:SettingsCard>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="GeneralSettingsDetail" Spacing="24" Visibility="Collapsed">
                                    <StackPanel.Resources>
                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                    </StackPanel.Resources>
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="When you sign in" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                        <settings:SettingsCard x:Name="StartupSettingsCard" Header="Start with Windows"
                                                               Description="Launch CloudInlet in the system tray so your folders can stay up to date.">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=power, Size=24}"  Width="24" Height="24" Tag="power" /></settings:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Name="StartAtSignInBox" Style="{StaticResource CloudInletToggleStyle}"
                                                          AutomationProperties.Name="Start CloudInlet when I sign in" Toggled="Preference_Toggled" />
                                        </settings:SettingsCard>
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Working in the background" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                        <Grid x:Name="StartupBackgroundGrid" Tag="2" ColumnSpacing="12" RowSpacing="12" SizeChanged="SettingsDetailGrid_SizeChanged">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <settings:SettingsCard Header="Always within reach" Description="After account setup, CloudInlet opens quietly in the system tray. Select its tray icon to check progress or open the app.">
                                                <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=apps, Size=24}"  Width="24" Height="24" Tag="apps" /></settings:SettingsCard.HeaderIcon>
                                            </settings:SettingsCard>
                                            <settings:SettingsCard Grid.Column="1" Header="Notifications" Description="Choose the background activity you want to hear about." IsClickEnabled="True" Tag="settings/notifications" Click="QuickNavigate_Click">
                                                <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=alert, Size=24}"  Width="24" Height="24" Tag="alert" /></settings:SettingsCard.HeaderIcon>
                                            </settings:SettingsCard>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <ContentControl x:Name="NotificationSettingsDetail" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                                    <ContentControl.Resources>
                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                    </ContentControl.Resources>
                                    <StackPanel Spacing="24">
                                        <settings:SettingsCard Header="Windows notifications" Description="Receive CloudInlet alerts in Notification Center.">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=alert, Size=24}"  Width="24" Height="24" Tag="alert" /></settings:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Name="NotificationsSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Windows notifications" Toggled="NotificationPreference_Toggled" />
                                        </settings:SettingsCard>
                                        <ContentControl x:Name="NotificationChoices" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="24">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Notify me about" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                                    <Grid x:Name="NotificationEventsGrid" Tag="2" ColumnSpacing="12" RowSpacing="12" SizeChanged="SettingsDetailGrid_SizeChanged">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <settings:SettingsCard Header="Backup problems" Description="Files or your account need attention.">
                                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=warning, Size=24}"  Width="24" Height="24" Tag="warning" /></settings:SettingsCard.HeaderIcon>
                                                            <ToggleSwitch x:Name="NotificationProblemsSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Notify about backup problems" Toggled="NotificationPreference_Toggled" />
                                                        </settings:SettingsCard>
                                                        <settings:SettingsCard Grid.Column="1" Header="Folder backup changes" Description="A folder backup is enabled or stopped.">
                                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=folder, Size=24}"  Width="24" Height="24" Tag="folder" /></settings:SettingsCard.HeaderIcon>
                                                            <ToggleSwitch x:Name="NotificationFoldersSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Notify about folder backup changes" Toggled="NotificationPreference_Toggled" />
                                                        </settings:SettingsCard>
                                                        <settings:SettingsCard Grid.Row="1" Header="Sync completed" Description="A summary when your transfers finish.">
                                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=sync, Size=24}"  Width="24" Height="24" Tag="sync" /></settings:SettingsCard.HeaderIcon>
                                                            <ToggleSwitch x:Name="NotificationSyncSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Notify when sync completes" Toggled="NotificationPreference_Toggled" />
                                                        </settings:SettingsCard>
                                                        <settings:SettingsCard Grid.Row="1" Grid.Column="1" Header="App updates" Description="An update is available or ready to install.">
                                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=download, Size=24}"  Width="24" Height="24" Tag="download" /></settings:SettingsCard.HeaderIcon>
                                                            <ToggleSwitch x:Name="NotificationUpdatesSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Notify about app updates" Toggled="NotificationPreference_Toggled" />
                                                        </settings:SettingsCard>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Sound" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                                    <settings:SettingsCard Header="Play a notification sound" Description="Windows Do not disturb settings still apply.">
                                                        <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=music, Size=24}"  Width="24" Height="24" Tag="music" /></settings:SettingsCard.HeaderIcon>
                                                        <ToggleSwitch x:Name="NotificationSoundSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Play a notification sound" Toggled="NotificationPreference_Toggled" />
                                                    </settings:SettingsCard>
                                                </StackPanel>
                                            </StackPanel>
                                        </ContentControl>
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Related settings" Style="{StaticResource CloudInletSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                                            <settings:SettingsCard Header="Windows notification settings" Description="Manage banners, Notification Center, and Do not disturb." IsClickEnabled="True" Click="WindowsNotifications_Click">
                                                <settings:SettingsCard.HeaderIcon>
                                                    <AnimatedIcon Width="24" Height="24">
                                                        <AnimatedIcon.Source><animated:AnimatedSettingsVisualSource /></AnimatedIcon.Source>
                                                        <AnimatedIcon.FallbackIconSource><FontIconSource Glyph="&#xE713;" /></AnimatedIcon.FallbackIconSource>
                                                    </AnimatedIcon>
                                                </settings:SettingsCard.HeaderIcon>
                                                <settings:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></settings:SettingsCard.ActionIcon>
                                            </settings:SettingsCard>
                                        </StackPanel>
                                        <InfoBar x:Name="NotificationNotice" IsOpen="False" IsClosable="True" Severity="Warning" Title="Notification settings" />
                                    </StackPanel>
                                </ContentControl>
                                <StackPanel x:Name="AboutSettingsDetail" Spacing="24" Visibility="Collapsed">
                                    <Border Style="{StaticResource CloudInletSurfaceStyle}" Padding="24">
                                    <StackPanel Spacing="16">
                                    <Grid x:Name="UpdateHero" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <IconSourceElement IconSource="{views:FluentIcon Kind=sync, Size=40}"  Width="40" Height="40" Tag="sync" />
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateStatusText" Text="Updates are unavailable in this preview." Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="UpdateTimingText" Style="{StaticResource CloudInletBodySecondaryTextStyle}" />
                                            <ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" />
                                            <TextBlock x:Name="UpdateDownloadDetail" Visibility="Collapsed" Style="{StaticResource CloudInletSecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                            <views:ActionWrapPanel x:Name="UpdateActions" Spacing="8">
                                                <Button x:Name="DownloadUpdateButton" Content="Download update" Click="DownloadUpdate_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
                                                <Button x:Name="InstallUpdateButton" Content="Install and restart" Click="InstallUpdate_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
                                                <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdate_Click" MinHeight="32" />
                                                <Button x:Name="DeleteUpdateButton" Content="Delete downloads" Click="DeleteUpdate_Click"
                                                        ToolTipService.ToolTip="Delete downloaded update installers" AutomationProperties.Name="Delete downloaded updates" />
                                                <HyperlinkButton x:Name="UpdateReleaseLink" Content="Release notes" NavigateUri="https://github.com/TahsinFaiyaz30/CloudInlet/releases" />
                                            </views:ActionWrapPanel>
                                    </StackPanel>
                                    </Border>
                                    <InfoBar x:Name="UpdateNotice" IsOpen="False" Visibility="Collapsed" IsClosable="False" />
                                    <StackPanel x:Name="UpdatePreferencesPanel" Spacing="12">
                                        <TextBlock Text="Update preferences" Style="{StaticResource CloudInletSectionHeadingStyle}" Margin="0,0,0,4" />
                                        <Grid x:Name="UpdatePreferencesGrid" ColumnSpacing="12" RowSpacing="12" Tag="2" SizeChanged="SettingsDetailGrid_SizeChanged">
                                        <settings:SettingsCard Header="Check automatically" Description="Check GitHub Releases in the background.">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=clock, Size=24}"  Width="24" Height="24" Tag="clock" /></settings:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Name="AutoCheckUpdateSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Automatically check for updates" Toggled="UpdatePreference_Changed" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Check interval" Description="Server limits can delay the next check.">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=clock, Size=24}"  Width="24" Height="24" Tag="clock" /></settings:SettingsCard.HeaderIcon>
                                            <ComboBox x:Name="UpdateIntervalBox" Width="180" AutomationProperties.Name="Update check interval" SelectionChanged="UpdateInterval_Changed">
                                                <ComboBoxItem Content="Every hour" Tag="1" /><ComboBoxItem Content="Every 6 hours" Tag="6" />
                                                <ComboBoxItem Content="Every 12 hours" Tag="12" /><ComboBoxItem Content="Every day" Tag="24" />
                                                <ComboBoxItem Content="Every 3 days" Tag="72" /><ComboBoxItem Content="Every week" Tag="168" />
                                            </ComboBox>
                                        </settings:SettingsCard>
                                        <settings:SettingsCard x:Name="AutoDownloadUpdateCard" Header="Download automatically" Description="Download and verify a matching update when available.">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=download, Size=24}"  Width="24" Height="24" Tag="download" /></settings:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Name="AutoDownloadUpdateSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Automatically download updates" Toggled="UpdatePreference_Changed" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard x:Name="AutoInstallUpdateCard" Header="Install automatically" Description="Close CloudInlet, install silently, then resume with your current settings.">
                                            <settings:SettingsCard.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=sync, Size=24}"  Width="24" Height="24" Tag="sync" /></settings:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Name="AutoInstallUpdateSwitch" Style="{StaticResource CloudInletToggleStyle}" AutomationProperties.Name="Automatically install updates" Toggled="UpdatePreference_Changed" />
                                        </settings:SettingsCard>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                    <TextBlock Text="App information" Style="{StaticResource CloudInletSectionHeadingStyle}" />
                                    <settings:SettingsExpander x:Name="VersionCard" Header="CloudInlet" IsExpanded="True">
                                        <settings:SettingsExpander.HeaderIcon><IconSourceElement IconSource="{views:FluentIcon Kind=info, Size=24}"  Width="24" Height="24" Tag="info" /></settings:SettingsExpander.HeaderIcon>
                                        <settings:SettingsExpander.Items>
                                            <settings:SettingsCard Header="Diagnostics" Description="Open local diagnostics and activity logs.">
                                                <Button Content="Open diagnostics" Click="Diagnostics_Click" />
                                            </settings:SettingsCard>
                                        </settings:SettingsExpander.Items>
                                    </settings:SettingsExpander>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ContentControl x:Name="ServicesPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <Grid x:Name="BusyFooter" Grid.Row="1" Padding="24,16" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" />
                        <TextBlock
                            x:Name="FooterStatus"
                            Grid.Column="1"
                            Style="{StaticResource CloudInletSecondaryTextStyle}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
        <ContentDialog
            x:Name="CatalogDialog"
            Grid.RowSpan="2"
            Title="Backup providers and modes"
            CloseButtonText="Done"
            DefaultButton="Close">
            <Grid RowSpacing="16" MinWidth="300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Backblaze B2 supports native Windows backup today. This catalog describes native backup support; OneDrive cloud transfers are available from Cloud services."
                    Style="{StaticResource CloudInletSecondaryTextStyle}" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="CatalogKind"
                        Header="Browse"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="CatalogFilter_Changed">
                        <ComboBoxItem Content="Backup providers" />
                        <ComboBoxItem Content="Modes" />
                    </ComboBox>
                    <ComboBox
                        x:Name="CatalogGroup"
                        Grid.Column="1"
                        Header="Category"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="CatalogFilter_Changed" />
                </Grid>
                <AutoSuggestBox
                    x:Name="CatalogSearch"
                    Grid.Row="2"
                    PlaceholderText="Search providers"
                    QueryIcon="Find"
                    AutomationProperties.Name="Search providers and modes"
                    TextChanged="CatalogSearch_Changed" />
                <Grid Grid.Row="3">
                    <ListView
                        x:Name="CatalogList"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        HorizontalContentAlignment="Stretch"
                        MaxHeight="340"
                        MinHeight="100"
                        ItemTemplate="{StaticResource ProductOptionTemplate}" />
                    <TextBlock
                        x:Name="CatalogEmpty"
                        Text="No matching providers"
                        Style="{StaticResource CloudInletSecondaryTextStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
