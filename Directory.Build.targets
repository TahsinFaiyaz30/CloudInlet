<Project>
  <Target Name="ValidateCloudBayVersion" BeforeTargets="PrepareForBuild;CollectPackageReferences;GetAssemblyVersion">
    <Error Condition="'$(_CloudBayVersionDocumentValid)' != 'True'"
           Text="version.json must contain exactly one version property with a canonical stable X.Y.Z value." />
    <PropertyGroup>
      <_CloudBayEffectiveVersionValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '\A(?:0|[1-9][0-9]{0,4})\.(?:0|[1-9][0-9]{0,4})\.(?:0|[1-9][0-9]{0,4})\z'))</_CloudBayEffectiveVersionValid>
    </PropertyGroup>
    <Error Condition="'$(_CloudBayEffectiveVersionValid)' != 'True'"
           Text="CloudBay Version must be a canonical stable X.Y.Z value." />
    <Error Condition="$([System.Version]::Parse('$(CloudBayBaseVersion)').Major) &gt; 255 Or $([System.Version]::Parse('$(CloudBayBaseVersion)').Minor) &gt; 255 Or $([System.Version]::Parse('$(CloudBayBaseVersion)').Build) &gt; 65535"
           Text="version.json exceeds common Windows Installer limits: major/minor at most 255, patch at most 65535." />
    <Error Condition="$([System.Version]::Parse('$(Version)').Major) &gt; 255 Or $([System.Version]::Parse('$(Version)').Minor) &gt; 255 Or $([System.Version]::Parse('$(Version)').Build) &gt; 65535"
           Text="CloudBay Version exceeds common Windows Installer limits: major/minor at most 255, patch at most 65535." />
  </Target>
</Project>
