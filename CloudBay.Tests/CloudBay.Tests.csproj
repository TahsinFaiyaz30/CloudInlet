    <Compile Include="../CloudBay/Windows/KnownFolderBackup.cs" Link="Native/KnownFolderBackup.cs" />
    <Compile Include="../CloudBay/Windows/ImportSourceDiscovery.cs" Link="Native/ImportSourceDiscovery.cs" />
    <Compile Include="../CloudBay/Windows/KnownFolderPolicy.cs" Link="Native/KnownFolderPolicy.cs" />
    <Compile Include="../CloudBay/Windows/FolderAppearance.cs" Link="Native/FolderAppearance.cs" />
