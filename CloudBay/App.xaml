<Application
    x:Class="CloudBay.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Native controls own their Windows 11 geometry, typography,
                 strokes, high contrast states, focus and reduced motion. -->
            <Thickness
                x:Key="CloudBayPageInset">32,32,32,40</Thickness>
            <Style
                x:Key="CloudBayPageContentStyle"
                TargetType="StackPanel">
                <Setter
                    Property="MaxWidth"
                    Value="1120" />
                <Setter
                    Property="Padding"
                    Value="{StaticResource CloudBayPageInset}" />
                <Setter
                    Property="Spacing"
                    Value="24" />
                <Setter
                    Property="HorizontalAlignment"
                    Value="Center" />
            </Style>
            <Style
                x:Key="CloudBayToggleStyle"
                TargetType="ToggleSwitch">
                <Setter
                    Property="MinWidth"
                    Value="0" />
                <Setter
                    Property="HorizontalAlignment"
                    Value="Right" />
                <Setter
                    Property="VerticalAlignment"
                    Value="Center" />
            </Style>
            <Style
                x:Key="CloudBayListItemStyle"
                TargetType="ListViewItem">
                <Setter Property="CornerRadius" Value="4" />
                <Setter
                    Property="Padding"
                    Value="0" />
                <Setter
                    Property="Margin"
                    Value="0,0,0,8" />
                <Setter
                    Property="HorizontalContentAlignment"
                    Value="Stretch" />
            </Style>
            <Style
                x:Key="CloudBaySecondaryTextStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>
            <Style x:Key="CloudBayBodySecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CloudBayAttentionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CloudBaySecondaryTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <DataTemplate
                x:Key="ActivityTemplate">
                <Grid
                    Padding="0,14"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{Binding Glyph}"
                        FontSize="20"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">
                        <TextBlock
                            Text="{Binding FileName}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock
                            Text="{Binding Summary}"
                            ToolTipService.ToolTip="{Binding TimeFullText}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                        <TextBlock
                            Text="{Binding Detail}"
                            Visibility="{Binding DetailVisibility}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ActivityRowTemplate">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="16,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActivityTemplate}" />
                </Border>
            </DataTemplate>
            <DataTemplate
                x:Key="TrayActivityTemplate">
                <Grid
                    Padding="12,12"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{Binding Glyph}"
                        FontSize="16"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">
                        <TextBlock
                            Text="{Binding FileName}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock
                            Text="{Binding Summary}"
                            ToolTipService.ToolTip="{Binding TimeFullText}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                        <TextBlock
                            Text="{Binding Detail}"
                            Visibility="{Binding DetailVisibility}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate
                x:Key="ProductOptionTemplate">
                <Grid
                    Padding="4,12"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Spacing="4">
                        <TextBlock
                            Text="{Binding Name}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding Description}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Status}"
                        VerticalAlignment="Top"
                        Margin="0,1,0,0"
                        Style="{StaticResource CloudBaySecondaryTextStyle}" />
                </Grid>
            </DataTemplate>
            <Style
                x:Key="CloudBayStatusSuccessIconStyle"
                TargetType="FontIcon">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style
                x:Key="CloudBayStatusCautionIconStyle"
                TargetType="FontIcon">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style
                x:Key="CloudBayStatusNeutralIconStyle"
                TargetType="FontIcon">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style
                x:Key="CloudBayStatusAccentIconStyle"
                TargetType="FontIcon">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
