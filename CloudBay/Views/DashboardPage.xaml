<Page
    x:Class="CloudBay.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="DashboardScroller"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Loaded="DashboardScroller_Loaded">
        <StackPanel MaxWidth="1160" Margin="30,20,30,30" Spacing="22">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource CloudBayPageTitleStyle}" Text="Dashboard" />
                    <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="Your Windows folders and mounted storage in one place." />
                </StackPanel>
                <CommandBar Grid.Column="1" VerticalAlignment="Center"
                            DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarButton Icon="Refresh" Label="Refresh status"
                                  Command="{Binding RefreshCommand}"
                                  IsEnabled="{Binding CanRunOperations}" />
                </CommandBar>
            </Grid>

            <Border Style="{StaticResource CloudBayPanelStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource CloudBayEyebrowStyle}" Text="CLOUD STORAGE" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="20" Glyph="&#xE8B7;" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding RootHealth}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                                       Text="{Binding RootMessage}" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Style="{StaticResource CloudBayStatusChipStyle}">
                            <TextBlock Text="{Binding FileSystem}" FontSize="12" />
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="RootPathBox"
                                 Grid.ColumnSpan="3"
                                 Header="Mounted folder or drive"
                                 PlaceholderText="Select a mounted drive or folder"
                                 Text="{Binding RootPathInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center"
                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                   Text="{Binding RootPath}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="1" Grid.Column="1" MinWidth="86"
                                Click="BrowseRoot_Click" Content="Browse" />
                        <Button Grid.Row="1" Grid.Column="2" MinWidth="112"
                                Command="{Binding ConfigureRootCommand}"
                                IsEnabled="{Binding CanRunOperations}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Connect root" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="SummaryWide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1060" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="SummaryNarrow">
                            <VisualState.Setters>
                                <Setter Target="StorageMetric.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="FoldersMetric.(Grid.Row)" Value="1" />
                                <Setter Target="FoldersMetric.(Grid.Column)" Value="0" />
                                <Setter Target="FoldersMetric.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="LinksMetric.(Grid.Row)" Value="2" />
                                <Setter Target="LinksMetric.(Grid.Column)" Value="0" />
                                <Setter Target="LinksMetric.(Grid.ColumnSpan)" Value="3" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="StorageMetric" Grid.Column="0" Style="{StaticResource CloudBayRowStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CloudBayEyebrowStyle}" Text="SPACE REPORTED BY MOUNT" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StorageSummary}" TextWrapping="Wrap" />
                        <ProgressBar Margin="0,6,0,0" Height="4" Maximum="100" Value="{Binding StorageUsedPercent}" />
                    </StackPanel>
                </Border>
                <Border x:Name="FoldersMetric" Grid.Column="1" Style="{StaticResource CloudBayRowStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CloudBayEyebrowStyle}" Text="SYSTEM FOLDERS" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ManagedFoldersCount}" />
                        <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}" FontSize="12"
                                   Text="managed by CloudBay" />
                    </StackPanel>
                </Border>
                <Border x:Name="LinksMetric" Grid.Column="2" Style="{StaticResource CloudBayRowStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CloudBayEyebrowStyle}" Text="CUSTOM LINKS" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CustomLinksCount}" />
                        <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}" FontSize="12"
                                   Text="connected folders" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="DetailsWide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1060" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="DetailsNarrow">
                            <VisualState.Setters>
                                <Setter Target="PersonalSection.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="ActivitySection.(Grid.Row)" Value="1" />
                                <Setter Target="ActivitySection.(Grid.Column)" Value="0" />
                                <Setter Target="ActivitySection.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel x:Name="PersonalSection" Grid.Column="0" Spacing="11">
                    <TextBlock Style="{StaticResource CloudBaySectionTitleStyle}" Text="Personal folders" />
                    <ItemsControl ItemsSource="{Binding KnownFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Style="{StaticResource CloudBayRowStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Center" FontSize="18"
                                                  Glyph="{Binding IconGlyph}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock FontSize="12"
                                                       Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                       Text="{Binding CurrentPath}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center"
                                                Style="{StaticResource CloudBayStatusChipStyle}">
                                            <TextBlock FontSize="11" Text="{Binding State}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="ActivitySection" Grid.Column="1" Spacing="11">
                    <TextBlock Style="{StaticResource CloudBaySectionTitleStyle}" Text="Recent activity" />
                    <Border Style="{StaticResource CloudBayPanelStyle}">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding RecentJournals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,11" Spacing="4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Operation}" />
                                                <TextBlock Grid.Column="1" FontSize="11"
                                                           Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                           Text="{Binding When}" />
                                            </Grid>
                                            <TextBlock FontSize="12"
                                                       Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                       Text="{Binding Detail}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                                       Visibility="{Binding NoJournalsVisibility}"
                                       Text="No changes yet. CloudBay will record every folder and storage operation here." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CloudBayPanelStyle}">
                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource CloudBayEyebrowStyle}" Text="DEVELOPER SHIELD" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding ActiveFiltersCount}" />
                            <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                                       Text="built-in cache names excluded from sync" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
