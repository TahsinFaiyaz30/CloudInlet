<Page
    x:Class="CloudBay.Views.SystemFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1160" Margin="30,20,30,30" Spacing="18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource CloudBayPageTitleStyle}" Text="System Folders" />
                    <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="Live Windows locations for your desktop, documents, and media." />
                </StackPanel>
                <CommandBar Grid.Column="1" VerticalAlignment="Center"
                            DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarButton Icon="Refresh" Label="Refresh paths"
                                  Command="{Binding RefreshCommand}"
                                  IsEnabled="{Binding CanRunOperations}" />
                </CommandBar>
            </Grid>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Protected changes"
                     Message="CloudBay checks destinations and records a rollback journal before a folder move. Restore never purges local or cloud files." />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CloudBaySectionTitleStyle}"
                           Text="Windows locations" />
                <Border Grid.Column="1" Style="{StaticResource CloudBayStatusChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="12" Text="Managed" />
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Text="{Binding ManagedFoldersCount}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding KnownFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,7" Style="{StaticResource CloudBayRowStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="28" VerticalAlignment="Top" Margin="0,4,0,0"
                                          FontSize="20" Glyph="{Binding IconGlyph}" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <Border Style="{StaticResource CloudBayStatusChipStyle}">
                                            <TextBlock FontSize="11" Text="{Binding State}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentPath}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock FontSize="12"
                                               Style="{StaticResource CloudBaySecondaryTextStyle}"
                                               Text="{Binding Message}" />
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                   Text="Local default:" />
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                   Text="{Binding DefaultPath}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <Button MinWidth="108"
                                            Command="{Binding RedirectCommand}"
                                            IsEnabled="{Binding CanRedirect}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Content="Redirect" />
                                    <Button MinWidth="108"
                                            Command="{Binding RestoreCommand}"
                                            IsEnabled="{Binding CanRestore}"
                                            Content="Restore" />
                                    <Button MinWidth="108"
                                            Click="RecoverLegacy_Click"
                                            IsEnabled="{Binding CanRecoverLegacy}"
                                            Visibility="{Binding RecoveryVisibility}"
                                            Content="Recover local" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CloudBayPanelStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="Keep Downloads local" />
                        <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                                   Text="Installers and browser downloads stay off the sync pipeline unless you choose otherwise." />
                    </StackPanel>
                    <ToggleSwitch x:Name="DownloadsToggle"
                                  Grid.Column="1" VerticalAlignment="Center"
                                  IsOn="{Binding IncludeDownloads, Mode=OneWay}"
                                  IsEnabled="{Binding CanRunOperations}"
                                  OnContent="Included" OffContent="Local"
                                  Toggled="DownloadsToggle_Toggled" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource CloudBaySectionTitleStyle}"
                               Text="OneDrive files left behind" />
                    <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="Scan inactive OneDrive locations and preview a safe copy to local or cloud storage." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center"
                        Command="{Binding RefreshOrphansCommand}"
                        IsEnabled="{Binding CanRunOperations}"
                        Content="Scan folders" />
            </Grid>

            <ItemsControl ItemsSource="{Binding OrphanedFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,7" Style="{StaticResource CloudBayRowStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Margin="0,4,0,0" Glyph="&#xE8B7;" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Text="{Binding Kind}" />
                                        <Border Style="{StaticResource CloudBayStatusChipStyle}">
                                            <TextBlock FontSize="11" Text="{Binding State}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" TextWrapping="WrapWholeWords" />
                                    <TextBlock FontSize="12"
                                               Style="{StaticResource CloudBaySecondaryTextStyle}"
                                               Text="{Binding Message}" />
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                   Text="{Binding FileCount}" />
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                   Text="files ·" />
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                   Text="{Binding Size}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <Button MinWidth="126" Tag="Local"
                                            Click="RecoverOrphan_Click"
                                            IsEnabled="{Binding CanRecoverLocal}"
                                            Content="Copy to local" />
                                    <Button MinWidth="126" Tag="Cloud"
                                            Click="RecoverOrphan_Click"
                                            IsEnabled="{Binding CanRecoverCloud}"
                                            Content="Copy to cloud" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CloudBayRowStyle}"
                    Visibility="{Binding NoOrphansVisibility}">
                <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                           Text="No inactive OneDrive personal folders were found." />
            </Border>
            <Border Style="{StaticResource CloudBayRowStyle}"
                    Visibility="{Binding OrphanScanPromptVisibility}">
                <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                           Text="Run a scan when you want to check old OneDrive folders. Large profiles can take time to count." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
