<Window
    x:Class="CloudBay.Views.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">
    <Window.SystemBackdrop>
        <MicaBackdrop
            Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Border
        x:Name="TrayRoot"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Padding="20,16"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="Auto" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Source="/Assets/CloudBay-32.png"
                    Width="28"
                    Height="28" />
                <StackPanel
                    Grid.Column="1"
                    Spacing="2">
                    <TextBlock
                        Text="CloudBay"
                        Style="{StaticResource BodyLargeTextBlockStyle}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="TrayBucket"
                        Text="{Binding BucketLabel}"
                        FontSize="12"
                        Style="{StaticResource CloudBaySecondaryTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    x:Name="QuickSettingsButton"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Quick settings"
                    ToolTipService.ToolTip="Quick settings"
                    PointerEntered="QuickSettings_PointerEntered"
                    PointerExited="QuickSettings_PointerExited"
                    GotFocus="QuickSettings_GotFocus"
                    LostFocus="QuickSettings_LostFocus">
                    <AnimatedIcon
                        x:Name="QuickSettingsIcon"
                        Width="20"
                        Height="20">
                        <AnimatedIcon.Source>
                            <animated:AnimatedSettingsVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <FontIconSource
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="QuickSettingsMenu"
                            Placement="BottomEdgeAlignedRight"
                            Opening="QuickSettings_Opening"
                            Closed="QuickSettings_Closed">
                            <MenuFlyoutItem
                                x:Name="QuickSyncNow"
                                Text="Sync now"
                                Click="SyncNow_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon
                                        Glyph="" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem
                                x:Name="PauseMenu"
                                Text="Pause syncing">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon
                                        Glyph="" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem
                                    Text="For 1 hour"
                                    Tag="1"
                                    Click="PauseFor_Click" />
                                <MenuFlyoutItem
                                    Text="For 2 hours"
                                    Tag="2"
                                    Click="PauseFor_Click" />
                                <MenuFlyoutItem
                                    Text="For 8 hours"
                                    Tag="8"
                                    Click="PauseFor_Click" />
                                <MenuFlyoutItem
                                    Text="Until I resume"
                                    Tag="0"
                                    Click="PauseFor_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                x:Name="ResumeMenu"
                                Text="Resume syncing"
                                Click="Resume_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon
                                        Glyph="" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                x:Name="MeteredQuickSetting"
                                Text="Pause on metered connections"
                                Click="MeteredQuickSetting_Click" />
                            <ToggleMenuFlyoutItem
                                x:Name="BatteryQuickSetting"
                                Text="Pause with Battery Saver"
                                Click="BatteryQuickSetting_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="QuickOpenFolder"
                                Text="Open CloudBay folder"
                                Click="OpenFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon
                                        Glyph="" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="All settings"
                                Click="AllSettings_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon
                                        Glyph="" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="Quit CloudBay"
                                Click="Quit_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon
                                        Glyph="" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <StackPanel
                Grid.Row="1"
                Padding="20,4,20,18"
                Spacing="12">
                <Grid
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{Binding StatusGlyph}"
                        FontSize="24"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">
                        <TextBlock
                            Text="{Binding StatusTitle}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TrayStatusDetail"
                            Text="{Binding StatusDescription}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}"
                            FontSize="12" />
                        <TextBlock
                            x:Name="TrayLastSync"
                            Text="{Binding LastSyncLabel}"
                            ToolTipService.ToolTip="{Binding LastSyncFullLabel}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}"
                            FontSize="12" />
                    </StackPanel>
                </Grid>
                <StackPanel
                    x:Name="TrayTransferPanel"
                    Visibility="Collapsed"
                    Spacing="6">
                    <ProgressBar
                        x:Name="TrayProgress"
                        Value="{Binding Progress}"
                        Maximum="100" />
                    <TextBlock
                        Text="{Binding ProgressLabel}"
                        Style="{StaticResource CloudBaySecondaryTextStyle}"
                        FontSize="12" />
                </StackPanel>
                <InfoBar
                    x:Name="TrayError"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Error" />
            </StackPanel>
            <Grid
                x:Name="TrayActivityHeading"
                Grid.Row="2"
                Padding="20,12,20,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    Text="Recent activity"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
            <Grid
                x:Name="TrayActivitySection"
                Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                    ItemsSource="{Binding RecentActivity}"
                    ItemTemplate="{StaticResource TrayActivityTemplate}"
                    SelectionMode="None"
                    HorizontalContentAlignment="Stretch"
                    Padding="8,0,8,8"
                    MaxHeight="250" />
            </Grid>
            <Grid
                Grid.Row="4"
                Padding="20,14"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="TrayPrimaryColumn"
                        Width="*" />
                    <ColumnDefinition
                        x:Name="TrayActivityColumn"
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="TrayOpenFolder"
                    Content="Open folder"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OpenFolder_Click" />
                <Button
                    x:Name="TrayViewActivity"
                    Grid.Column="1"
                    Content="View activity"
                    HorizontalAlignment="Stretch"
                    Click="ViewActivity_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>