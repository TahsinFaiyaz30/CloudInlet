<Window
    x:Class="CloudBay.Views.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Border x:Name="TrayRoot" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Padding="20,16" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/Assets/CloudBay-32.png" Width="28" Height="28"/>
                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="CloudBay" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding BucketLabel}" FontSize="11" Style="{StaticResource CloudBaySecondaryTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button x:Name="QuickSettingsButton" Grid.Column="2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Quick settings" ToolTipService.ToolTip="Quick settings">
                    <FontIcon Glyph="&#xE713;" FontSize="17"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="QuickSettingsMenu" Placement="BottomEdgeAlignedRight" Opening="QuickSettings_Opening" Closed="QuickSettings_Closed">
                            <MenuFlyoutItem Text="Sync now" Click="SyncNow_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="PauseMenu" Text="Pause syncing"><MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE769;"/></MenuFlyoutSubItem.Icon><MenuFlyoutItem Text="For 1 hour" Tag="1" Click="PauseFor_Click"/><MenuFlyoutItem Text="For 2 hours" Tag="2" Click="PauseFor_Click"/><MenuFlyoutItem Text="For 8 hours" Tag="8" Click="PauseFor_Click"/><MenuFlyoutItem Text="Until I resume" Tag="0" Click="PauseFor_Click"/></MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="ResumeMenu" Text="Resume syncing" Click="Resume_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="MeteredQuickSetting" Text="Pause on metered connections" Click="MeteredQuickSetting_Click" />
                            <ToggleMenuFlyoutItem x:Name="BatteryQuickSetting" Text="Pause with Battery Saver" Click="BatteryQuickSetting_Click" />
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Open CloudBay folder" Click="OpenFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="All settings" Click="AllSettings_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Quit CloudBay" Click="Quit_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Padding="20,4,20,18" Spacing="12">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"><FontIcon Glyph="{Binding StatusGlyph}" FontSize="19" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusDescription}" Style="{StaticResource CloudBaySecondaryTextStyle}" FontSize="12"/></StackPanel></Grid>
                <StackPanel x:Name="TrayTransferPanel" Visibility="Collapsed" Spacing="6"><ProgressBar x:Name="TrayProgress" Value="{Binding Progress}" Maximum="100"/><TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource CloudBaySecondaryTextStyle}" FontSize="11"/></StackPanel>
                <TextBlock Text="{Binding PendingLabel}" Style="{StaticResource CloudBaySecondaryTextStyle}" FontSize="11"/>
                <InfoBar x:Name="TrayError" IsOpen="False" IsClosable="True" Severity="Error"/>
            </StackPanel>
            <Grid Grid.Row="2" Padding="20,12,20,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock Text="RECENT ACTIVITY" Style="{StaticResource CloudBayEyebrowStyle}" FontSize="10" CharacterSpacing="80"/></Grid>
            <Grid Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource TrayActivityTemplate}" SelectionMode="None" HorizontalContentAlignment="Stretch" Padding="8,0,8,8"/>
                <StackPanel x:Name="TrayEmptyActivity" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="10"><FontIcon Glyph="&#xE823;" FontSize="30"/><TextBlock Text="No activity yet" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Your uploads and downloads will appear here." Style="{StaticResource CloudBaySecondaryTextStyle}" FontSize="12" TextAlignment="Center" MaxWidth="270"/></StackPanel>
            </Grid>
            <Grid Grid.Row="4" Padding="20,14" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="TrayOpenFolder" Content="Open folder" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OpenFolder_Click"/><Button Grid.Column="1" Content="All settings" HorizontalAlignment="Stretch" Click="AllSettings_Click"/></Grid>
        </Grid>
    </Border>
</Window>
