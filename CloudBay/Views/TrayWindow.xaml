<Window
    x:Class="CloudBay.Views.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid
        x:Name="TrayRoot"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Grid.Resources>
            <Style x:Key="TraySuccessIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="TrayCautionIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="TrayNeutralIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TrayAccentIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <DataTemplate x:Key="TrayRecentActivityTemplate">
                <Grid Padding="0,12" ColumnSpacing="12" Loaded="ActivityRow_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{Binding Glyph}"
                        FontSize="20"
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            Text="{Binding FileName}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock
                            Text="{Binding Summary}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{Binding TimeFullText}" />
                        <TextBlock
                            Text="{Binding Detail}"
                            Visibility="{Binding DetailVisibility}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="TrayActivityOpenFolder" Width="32" Height="32" Padding="6" Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{Binding Actions.OpenFolderVisibility}" ToolTipService.ToolTip="{Binding Actions.OpenFolderToolTip}"
                                AutomationProperties.Name="Open activity folder" Click="ActivityOpenFolder_Click">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        </Button>
                        <Button x:Name="TrayActivityViewCloud" Width="32" Height="32" Padding="6" Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{Binding Actions.CloudVisibility}" ToolTipService.ToolTip="{Binding Actions.CloudToolTip}"
                                AutomationProperties.Name="View activity file versions in Backblaze B2" Click="ActivityViewCloud_Click">
                            <FontIcon Glyph="&#xE753;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TrayTransferTemplate">
                <Grid Padding="0,8" ColumnSpacing="12" Loaded="ActivityRow_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{Binding Glyph}" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Location}" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource CloudBaySecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Location}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CloudBaySecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTipService.ToolTip="{Binding Summary}" />
                        <TextBlock x:Name="TrayFileSpeed" Text="{Binding SpeedText}" Visibility="{Binding SpeedVisibility}"
                                   Style="{StaticResource CloudBaySecondaryTextStyle}" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}"
                                     Visibility="{Binding ProgressVisibility}" AutomationProperties.Name="{Binding ProgressAccessibleName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="TrayActivityOpenFolder" Width="32" Height="32" Padding="6" Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{Binding Actions.OpenFolderVisibility}" ToolTipService.ToolTip="{Binding Actions.OpenFolderToolTip}"
                                AutomationProperties.Name="Open activity folder" Click="ActivityOpenFolder_Click">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        </Button>
                        <Button x:Name="TrayActivityViewCloud" Width="32" Height="32" Padding="6" Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{Binding Actions.CloudVisibility}" ToolTipService.ToolTip="{Binding Actions.CloudToolTip}"
                                AutomationProperties.Name="View activity file versions in Backblaze B2" Click="ActivityViewCloud_Click">
                            <FontIcon Glyph="&#xE753;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The identity stays on Mica; the activity uses one distinct content layer. -->
        <Grid Padding="24,20,20,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/CloudBay-32.png" Width="32" Height="32" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="CloudBay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="TrayBucket"
                    Text="{Binding BucketLabel}"
                    Style="{StaticResource CloudBaySecondaryTextStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Name="QuickSettingsButton"
                Grid.Column="2"
                Width="40"
                Height="40"
                Padding="10"
                Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.Name="Quick settings"
                ToolTipService.ToolTip="Quick settings"
                PointerEntered="QuickSettings_PointerEntered"
                PointerExited="QuickSettings_PointerExited"
                GotFocus="QuickSettings_GotFocus"
                LostFocus="QuickSettings_LostFocus">
                <AnimatedIcon x:Name="QuickSettingsIcon" Width="20" Height="20">
                    <AnimatedIcon.Source>
                        <animated:AnimatedSettingsVisualSource />
                    </AnimatedIcon.Source>
                    <AnimatedIcon.FallbackIconSource>
                        <FontIconSource FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="QuickSettingsMenu"
                        Placement="BottomEdgeAlignedRight"
                        Opening="QuickSettings_Opening"
                        Closed="QuickSettings_Closed">
                        <MenuFlyoutItem x:Name="QuickSyncNow" Text="Sync now" Click="SyncNow_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="PauseMenu" Text="Pause syncing">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="For 1 hour" Tag="1" Click="PauseFor_Click" />
                            <MenuFlyoutItem Text="For 2 hours" Tag="2" Click="PauseFor_Click" />
                            <MenuFlyoutItem Text="For 8 hours" Tag="8" Click="PauseFor_Click" />
                            <MenuFlyoutItem Text="Until I resume" Tag="0" Click="PauseFor_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Name="ResumeMenu" Text="Resume syncing" Click="Resume_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="MeteredQuickSetting"
                            Text="Pause on metered connections"
                            Click="MeteredQuickSetting_Click">
                            <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE701;" /></ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            x:Name="BatteryQuickSetting"
                            Text="Pause with Battery Saver"
                            Click="BatteryQuickSetting_Click">
                            <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE850;" /></ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="QuickOpenFolder" Text="Open CloudBay folder" Click="OpenFolder_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="All settings" Click="AllSettings_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Quit CloudBay" Click="Quit_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Border
            x:Name="TrayContentSurface"
            Grid.Row="1"
            Margin="12,0,12,0"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <!-- This viewport can shrink on a small monitor without hiding the footer. -->
            <ScrollViewer
                x:Name="TrayContentScroll"
                MaxHeight="520"
                Padding="24"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="TrayStatusGlyph"
                            Glyph="{Binding StatusGlyph}"
                            FontSize="32"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                x:Name="TrayStatusTitle"
                                Text="{Binding StatusTitle}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TrayStatusDetail"
                                Text="{Binding StatusDescription}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TrayLastSync"
                                Text="{Binding LastSyncLabel}"
                                ToolTipService.ToolTip="{Binding LastSyncFullLabel}"
                                Style="{StaticResource CloudBaySecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="TrayTransferPanel" Visibility="Collapsed" Spacing="8">
                        <ProgressBar x:Name="TrayProgress" Value="{Binding Progress}" Maximum="100" />
                        <TextBlock
                            x:Name="TrayProgressDetail"
                            Text="{Binding ProgressLabel}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="TrayLiveTransfers" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="In progress" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="TrayTransferSpeed" Text="{Binding TransferSpeedSummary}"
                                   Style="{StaticResource CloudBaySecondaryTextStyle}" Visibility="Collapsed"
                                   AutomationProperties.Name="Measured transfer speed" />
                        <ItemsControl x:Name="TrayTransferList" ItemsSource="{Binding RecentTransfers}"
                                      ItemTemplate="{StaticResource TrayTransferTemplate}" />
                        <TextBlock x:Name="TrayAdditionalTransfers" Text="{Binding AdditionalTransfersSummary}"
                                   Style="{StaticResource CloudBaySecondaryTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                    <HyperlinkButton x:Name="TrayQueueAction" Content="{Binding QueueSummary}" Padding="0"
                                     HorizontalAlignment="Left" Click="ViewQueue_Click" Visibility="Collapsed"
                                     AutomationProperties.Name="View queued files" />
                    <InfoBar
                        x:Name="TrayError"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Error"
                        Closed="TrayError_Closed" />
                    <Grid x:Name="TrayActivityHeading" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Row="1" Text="Recent activity" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ListView
                        x:Name="TrayActivitySection"
                        ItemsSource="{Binding RecentActivity}"
                        ItemTemplate="{StaticResource TrayRecentActivityTemplate}"
                        SelectionMode="None"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="TrayFooter" Grid.Row="2" Padding="20,16,20,20" ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TrayPrimaryColumn" Width="*" />
                <ColumnDefinition x:Name="TrayActivityColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TrayOpenFolder"
                Style="{StaticResource AccentButtonStyle}"
                MinHeight="48"
                HorizontalAlignment="Stretch"
                Click="TrayPrimary_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="TrayPrimaryGlyph" Glyph="&#xE8B7;" FontSize="16" />
                    <TextBlock x:Name="TrayPrimaryLabel" Text="Open folder" />
                </StackPanel>
            </Button>
            <Button
                x:Name="TrayViewActivity"
                Grid.Column="1"
                MinHeight="48"
                AutomationProperties.Name="View activity"
                HorizontalAlignment="Stretch"
                Click="ViewActivity_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    <TextBlock x:Name="TrayActivityLabel" Text="Activity" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
