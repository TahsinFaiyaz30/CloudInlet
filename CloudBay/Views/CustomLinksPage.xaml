<Page
    x:Class="CloudBay.Views.CustomLinksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1160" Margin="30,20,30,30" Spacing="18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource CloudBayPageTitleStyle}" Text="Custom Links" />
                    <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="Place project folders in cloud storage while keeping their familiar local paths." />
                </StackPanel>
                <CommandBar Grid.Column="1" VerticalAlignment="Center"
                            DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarButton Icon="Refresh" Label="Refresh links"
                                  Command="{Binding RefreshCommand}"
                                  IsEnabled="{Binding CanRunOperations}" />
                </CommandBar>
            </Grid>

            <Border Style="{StaticResource CloudBayPanelStyle}">
                <StackPanel Spacing="15">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource CloudBaySectionTitleStyle}"
                                   Text="Connect a local folder" />
                        <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                                   Text="CloudBay verifies the source, cloud destination, and available space before creating a native directory link." />
                    </StackPanel>

                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" VerticalAlignment="Center" Glyph="&#xE8B7;" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource CloudBaySecondaryTextStyle}"
                                       Text="Drop a folder here, or choose one below" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="10" RowSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="Local folder"
                                 PlaceholderText="Choose a folder on this PC"
                                 Text="{Binding CustomLocalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom"
                                Click="BrowseLocal_Click" Content="Browse" />
                        <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                 Header="Name in cloud root"
                                 PlaceholderText="Uses the folder name when left blank"
                                 Text="{Binding CustomTargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                   Text="Link removal keeps source and cloud files intact." />
                        <Button Grid.Column="1" MinWidth="126"
                                Command="{Binding LinkFolderCommand}"
                                IsEnabled="{Binding CanApplyCloudChanges}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Create link" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CloudBaySectionTitleStyle}"
                           Text="Connected folders" />
                <Border Grid.Column="1" Style="{StaticResource CloudBayStatusChipStyle}">
                    <TextBlock FontSize="12" Text="{Binding CustomLinksCount}" />
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding CustomLinks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,7" Style="{StaticResource CloudBayRowStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Margin="0,4,0,0" Glyph="&#xE71B;" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding LocalPath}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock FontSize="12"
                                               Style="{StaticResource CloudBaySecondaryTextStyle}"
                                               Text="{Binding CloudPath}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                   Text="{Binding Kind}" />
                                        <Border Style="{StaticResource CloudBayStatusChipStyle}">
                                            <TextBlock FontSize="11" Text="{Binding State}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="90" VerticalAlignment="Center"
                                        Command="{Binding UnlinkCommand}"
                                        IsEnabled="{Binding CanUnlink}"
                                        Content="Unlink" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CloudBayRowStyle}" Visibility="{Binding NoLinksVisibility}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="18" Glyph="&#xE71B;" />
                    <TextBlock Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="No custom links yet. Connect a folder to see it here." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
