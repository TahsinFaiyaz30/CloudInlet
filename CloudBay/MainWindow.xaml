<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    x:Class="CloudBay.MainWindow">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="CloudBay">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/CloudBay-32.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="224"
            CompactPaneLength="56"
            CompactModeThresholdWidth="820"
            ExpandedModeThresholdWidth="1020"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            AlwaysShowHeader="False"
            SelectionChanged="Navigation_SelectionChanged"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Icon="Home" Tag="overview" />
                <NavigationViewItem Content="Activity" Icon="Clock" Tag="activity" />
                <NavigationViewItem Content="Folder backup" Icon="Folder" Tag="backup" />
                <NavigationViewItem Content="Files" Icon="Document" Tag="files" />
            </NavigationView.MenuItems>
            <Grid x:Name="ContentLayoutGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="StatusInfoBar" Margin="32,16,32,0" IsOpen="False" IsClosable="True" />
                <ScrollViewer
                    x:Name="OverviewPage"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="OverviewContent" Style="{StaticResource CloudBayPageContentStyle}">
                        <StackPanel x:Name="WelcomePanel" Spacing="24" Margin="0,16,0,0">
                            <FontIcon
                                Glyph=""
                                FontSize="40"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                HorizontalAlignment="Left" />
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="A home for your files"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="Back up your folders to Backblaze B2 and open your files right from Windows."
                                    Style="{StaticResource CloudBaySecondaryTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Name="ConnectAccountButton"
                                Content="Connect your account"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Settings_Click" />
                        </StackPanel>
                        <StackPanel x:Name="ConnectedOverview" Spacing="32" Visibility="Collapsed">
                            <TextBlock Text="Overview" Style="{StaticResource TitleTextBlockStyle}" />
                            <StackPanel Spacing="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="48" Height="48" VerticalAlignment="Top">
                                        <FontIcon
                                            Glyph=""
                                            FontSize="44"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Border
                                            VerticalAlignment="Bottom"
                                            Height="20"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            Width="20"
                                            HorizontalAlignment="Right"
                                            CornerRadius="10">
                                            <FontIcon
                                                Glyph="{Binding StatusGlyph}"
                                                FontSize="12"
                                                x:Name="OverviewStatusIcon" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock
                                            Text="{Binding StatusTitle}"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="OverviewStatusDetail"
                                            Text="{Binding StatusDescription}"
                                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                        <TextBlock
                                            x:Name="OverviewLastSync"
                                            Text="{Binding LastSyncLabel}"
                                            ToolTipService.ToolTip="{Binding LastSyncFullLabel}"
                                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="TransferProgressPanel" Spacing="8" Visibility="Collapsed">
                                    <ProgressBar x:Name="TransferProgress" Value="{Binding Progress}" Maximum="100" />
                                    <TextBlock
                                        Text="{Binding ProgressLabel}"
                                        Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="DashboardActions" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ReviewDeletionsButton"
                                        Content="Review pending deletions"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="ReviewDeletions_Click" />
                                    <Button
                                        x:Name="OpenFolderButton"
                                        Content="Open folder"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenFolder_Click" />
                                    <Button x:Name="SyncNowButton" Content="Sync now" Click="SyncNow_Click" />
                                    <Button
                                        x:Name="DashboardPauseButton"
                                        Content="{Binding PauseLabel}"
                                        Click="Pause_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="BackupSuggestion" Spacing="12" Visibility="Collapsed">
                                <TextBlock
                                    Text="Protect your everyday folders"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Choose the Windows folders you want to back up."
                                    Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                <Button Content="Choose folders" Click="ManageBackup_Click" />
                            </StackPanel>
                            <StackPanel x:Name="RecentActivitySection" Spacing="12" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock
                                        Text="Recent activity"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <HyperlinkButton
                                        Content="View all"
                                        HorizontalAlignment="Right"
                                        Padding="0"
                                        Click="ViewActivity_Click" />
                                </Grid>
                                <ItemsControl
                                    ItemsSource="{Binding RecentActivity}"
                                    ItemTemplate="{StaticResource ActivityTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid
                    x:Name="ActivityPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    MaxWidth="1120"
                    HorizontalAlignment="Center"
                    Padding="{StaticResource CloudBayPageInset}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8" Margin="0,0,0,24">
                        <TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="ActivityPending"
                            Text="{Binding PendingLabel}"
                            Style="{StaticResource CloudBaySecondaryTextStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="ActivityList"
                            ItemsSource="{Binding Activity}"
                            ItemTemplate="{StaticResource ActivityTemplate}"
                            ItemContainerStyle="{StaticResource CloudBayListItemStyle}"
                            SelectionMode="None"
                            HorizontalContentAlignment="Stretch" />
                        <StackPanel
                            x:Name="ActivityEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <FontIcon
                                Glyph=""
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="No transfers yet" Style="{StaticResource CloudBaySecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <ScrollViewer
                    x:Name="BackupPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="BackupContent" Style="{StaticResource CloudBayPageContentStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Folder backup" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="Keep your Windows folders backed up and available in File Explorer."
                                Style="{StaticResource CloudBaySecondaryTextStyle}" />
                        </StackPanel>
                        <InfoBar
                            x:Name="BackupConnectInfo"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Message="Connect your account to choose folders.">
                            <InfoBar.ActionButton>
                                <Button Content="Connect" Click="Settings_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Windows folders" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="12" RowSpacing="12" x:Name="BackupRows" />
                            <settings:SettingsExpander
                                x:Name="MoreWindowsFolders"
                                Header="More Windows folders"
                                Description="Additional personal folders available in Windows.">
                                <settings:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </settings:SettingsExpander.HeaderIcon>
                                <settings:SettingsExpander.Items>
                                    <settings:SettingsCard
                                        BorderThickness="0"
                                        ContentAlignment="Vertical"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="12"
                                        Background="Transparent">
                                        <Grid ColumnSpacing="12" RowSpacing="12" x:Name="MoreBackupRows" />
                                    </settings:SettingsCard>
                                </settings:SettingsExpander.Items>
                            </settings:SettingsExpander>
                        </StackPanel>
                        <StackPanel x:Name="CustomBackupSection" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Other folders" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="12" RowSpacing="12" x:Name="CustomBackupRows" />
                        </StackPanel>
                        <settings:SettingsExpander
                            x:Name="CustomBackupExpander"
                            Header="Add another folder"
                            Description="Back up a personal folder from its current location.">
                            <settings:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="" />
                            </settings:SettingsExpander.HeaderIcon>
                            <settings:SettingsExpander.Items>
                                <settings:SettingsCard
                                    ContentAlignment="Vertical"
                                    HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="CustomBackupSourceBox"
                                                Header="Folder"
                                                PlaceholderText="Choose a folder" />
                                            <Button
                                                Grid.Column="1"
                                                Content="Browse…"
                                                Click="ChooseCustomBackup_Click"
                                                VerticalAlignment="Bottom" />
                                        </Grid>
                                        <TextBox
                                            x:Name="CustomBackupNameBox"
                                            Header="Backup name (optional)"
                                            PlaceholderText="Use the folder name"
                                            MaxLength="64" />
                                        <Button
                                            x:Name="AddCustomBackupButton"
                                            Content="Back up folder"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="AddCustomBackup_Click" />
                                    </StackPanel>
                                </settings:SettingsCard>
                            </settings:SettingsExpander.Items>
                        </settings:SettingsExpander>
                        <settings:SettingsExpander Header="How folder backup works">
                            <settings:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="" />
                            </settings:SettingsExpander.HeaderIcon>
                            <settings:SettingsExpander.Items>
                                <settings:SettingsCard
                                    ContentAlignment="Vertical"
                                    HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <TextBlock
                                            Text="Enabling a Windows folder makes CloudBay its default location. Turning backup off downloads its files and restores its original location. Folders protected by another provider must be restored locally first."
                                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                        <TextBlock
                                            Text="Changes and deletions sync between this PC and B2. Excluded files stay local. Previous versions are available while your bucket retains them."
                                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                        <HyperlinkButton
                                            Content="Review sync settings"
                                            Click="Settings_Click"
                                            HorizontalAlignment="Left"
                                            Padding="0" />
                                    </StackPanel>
                                </settings:SettingsCard>
                            </settings:SettingsExpander.Items>
                        </settings:SettingsExpander>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer
                    x:Name="FilesPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="FilesContent" Style="{StaticResource CloudBayPageContentStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Files" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="StorageSummary"
                                Text="{Binding StorageSummary}"
                                Style="{StaticResource CloudBaySecondaryTextStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="FilesConnectPanel" Spacing="16">
                            <TextBlock
                                Text="Connect your account to open your cloud files."
                                Style="{StaticResource CloudBaySecondaryTextStyle}" />
                            <Button
                                Content="Connect account"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Settings_Click" />
                        </StackPanel>
                        <StackPanel x:Name="FilesConnectedPanel" Spacing="24" Visibility="Collapsed">
                            <ComboBox
                                x:Name="FileScopeBox"
                                Header="Folder"
                                DisplayMemberPath="Name"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="FileScope_SelectionChanged" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="On this PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <settings:SettingsCard x:Name="FileLocationCard">
                                    <settings:SettingsCard.Header>
                                        <TextBlock x:Name="FileFolderName" Text="CloudBay folder" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.Description>
                                        <TextBlock x:Name="FileFolderPath" TextWrapping="Wrap" />
                                    </settings:SettingsCard.Description>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <Button
                                        Content="Open folder"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenFileFolder_Click" />
                                </settings:SettingsCard>
                                <TextBlock
                                    Text="Use Explorer to keep files on this device or free up downloaded space."
                                    Style="{StaticResource CloudBaySecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="File tools" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <settings:SettingsExpander
                                    x:Name="FileToolsExpander"
                                    Header="Availability and version history"
                                    Description="Manage an individual file.">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="16">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="FilePathBox"
                                                        Header="File in this folder"
                                                        PlaceholderText="Select a file or enter its relative path" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="Browse…"
                                                        Click="BrowseFile_Click"
                                                        VerticalAlignment="Bottom" />
                                                </Grid>
                                                <StackPanel
                                                    x:Name="FileActions"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button Content="Keep on this device" Click="PinFile_Click" />
                                                    <Button Content="Free up space" Click="FreeSpace_Click" />
                                                    <Button Content="Version history" Click="Versions_Click" />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="Free up space removes downloaded content after the file is safely in sync. Your cloud copy stays available."
                                                    Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                                <StackPanel
                                                    x:Name="VersionsPanel"
                                                    Visibility="Collapsed"
                                                    Spacing="12">
                                                    <TextBlock
                                                        Text="Version history"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock
                                                        x:Name="VersionPathLabel"
                                                        Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                                    <TextBlock
                                                        x:Name="VersionsEmptyLabel"
                                                        Text="No retained versions found."
                                                        Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                        Visibility="Collapsed" />
                                                    <ListView
                                                        x:Name="VersionsList"
                                                        SelectionMode="Single"
                                                        HorizontalContentAlignment="Stretch"
                                                        MaxHeight="320"
                                                        SelectionChanged="VersionsList_SelectionChanged">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Padding="8,12" ColumnSpacing="16">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock
                                                                            Text="{Binding Modified}"
                                                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                        <TextBlock
                                                                            Text="{Binding State}"
                                                                            Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Text="{Binding Size}"
                                                                        Style="{StaticResource CloudBaySecondaryTextStyle}"
                                                                        VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <Button
                                                        x:Name="RestoreVersionButton"
                                                        Content="Restore selected version"
                                                        Click="RestoreVersion_Click"
                                                        IsEnabled="False" />
                                                    <TextBlock
                                                        Text="Available versions depend on your B2 bucket's retention rules."
                                                        Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer
                    x:Name="SettingsPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsContent" Style="{StaticResource CloudBayPageContentStyle}">
                        <StackPanel x:Name="SettingsHub" Spacing="24">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <settings:SettingsCard
                                x:Name="SettingsAccountCard"
                                Header="Backblaze B2"
                                Description="Connect a private bucket to start protecting your files."
                                MinHeight="108"
                                Padding="24"
                                CornerRadius="8"
                                IsClickEnabled="True"
                                Tag="account"
                                Click="SettingsCategory_Click">
                                <settings:SettingsCard.HeaderIcon>
                                    <FontIcon
                                        Glyph=""
                                        FontSize="32"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </settings:SettingsCard.HeaderIcon>
                                <settings:SettingsCard.Resources>
                                    <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                </settings:SettingsCard.Resources>
                            </settings:SettingsCard>
                            <Grid x:Name="SettingsCategories" ColumnSpacing="16" RowSpacing="16">
                                <settings:SettingsCard
                                    x:Name="SyncCategory"
                                    Description="Files on demand and downloaded file storage."
                                    MinHeight="144"
                                    Padding="24"
                                    IsClickEnabled="True"
                                    Tag="sync"
                                    Click="SettingsCategory_Click"
                                    CornerRadius="8">
                                    <settings:SettingsCard.Header>
                                        <TextBlock
                                            Text="Sync"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon
                                            Glyph=""
                                            FontSize="32"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <settings:SettingsCard.Resources>
                                        <ResourceDictionary>
                                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                        </ResourceDictionary>
                                    </settings:SettingsCard.Resources>
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    x:Name="NetworkCategory"
                                    Description="Transfer limits and automatic pauses."
                                    MinHeight="144"
                                    Padding="24"
                                    IsClickEnabled="True"
                                    Tag="network"
                                    Click="SettingsCategory_Click"
                                    CornerRadius="8">
                                    <settings:SettingsCard.Header>
                                        <TextBlock
                                            Text="Network and power"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon
                                            Glyph=""
                                            FontSize="32"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <settings:SettingsCard.Resources>
                                        <ResourceDictionary>
                                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                        </ResourceDictionary>
                                    </settings:SettingsCard.Resources>
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    x:Name="AppearanceCategory"
                                    Description="Choose your app theme."
                                    MinHeight="144"
                                    Padding="24"
                                    IsClickEnabled="True"
                                    Tag="appearance"
                                    Click="SettingsCategory_Click"
                                    CornerRadius="8">
                                    <settings:SettingsCard.Header>
                                        <TextBlock
                                            Text="Appearance"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon
                                            Glyph=""
                                            FontSize="32"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <settings:SettingsCard.Resources>
                                        <ResourceDictionary>
                                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                        </ResourceDictionary>
                                    </settings:SettingsCard.Resources>
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    x:Name="GeneralCategory"
                                    Description="Background startup and Windows integration."
                                    MinHeight="144"
                                    Padding="24"
                                    IsClickEnabled="True"
                                    Tag="general"
                                    Click="SettingsCategory_Click"
                                    CornerRadius="8">
                                    <settings:SettingsCard.Header>
                                        <TextBlock
                                            Text="General"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon
                                            Glyph=""
                                            FontSize="32"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <settings:SettingsCard.Resources>
                                        <ResourceDictionary>
                                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                        </ResourceDictionary>
                                    </settings:SettingsCard.Resources>
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    x:Name="CatalogCategory"
                                    Description="See available and planned connections."
                                    MinHeight="144"
                                    Padding="24"
                                    IsClickEnabled="True"
                                    Tag="catalog"
                                    Click="SettingsCategory_Click"
                                    CornerRadius="8">
                                    <settings:SettingsCard.Header>
                                        <TextBlock
                                            Text="Providers and modes"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon
                                            Glyph=""
                                            FontSize="32"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <settings:SettingsCard.Resources>
                                        <ResourceDictionary>
                                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                        </ResourceDictionary>
                                    </settings:SettingsCard.Resources>
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    x:Name="AboutCategory"
                                    Description="Version information and local diagnostics."
                                    MinHeight="144"
                                    Padding="24"
                                    IsClickEnabled="True"
                                    Tag="about"
                                    Click="SettingsCategory_Click"
                                    CornerRadius="8">
                                    <settings:SettingsCard.Header>
                                        <TextBlock
                                            Text="About CloudBay"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon
                                            Glyph=""
                                            FontSize="32"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <settings:SettingsCard.Resources>
                                        <ResourceDictionary>
                                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                                        </ResourceDictionary>
                                    </settings:SettingsCard.Resources>
                                </settings:SettingsCard>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="SettingsDetail" Spacing="24" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="SettingsBackButton"
                                    Width="40"
                                    Height="40"
                                    Click="SettingsBack_Click"
                                    AutomationProperties.Name="Back to settings">
                                    <FontIcon Glyph="" FontSize="18" />
                                </Button>
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="SettingsDetailTitle"
                                    Text="Account"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel x:Name="AccountSettingsDetail" Spacing="4" Visibility="Collapsed">
                                <settings:SettingsCard
                                    x:Name="ConnectedAccountPanel"
                                    Header="{Binding BucketLabel}"
                                    Description="Backblaze B2"
                                    Visibility="Collapsed">
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <Button Content="Manage account" Click="ManageAccount_Click" />
                                </settings:SettingsCard>
                                <Border
                                    CornerRadius="8"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    x:Name="ConnectionPanel"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="24"
                                    MaxWidth="720"
                                    HorizontalAlignment="Left">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="32"
                                                VerticalAlignment="Top"
                                                Glyph=""
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Spacing="8" Grid.Column="1">
                                                <TextBlock
                                                    x:Name="AccountHeading"
                                                    Text="Backblaze B2"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    x:Name="AccountDescription"
                                                    Text="Enter your private bucket and application key."
                                                    Style="{StaticResource CloudBaySecondaryTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBox
                                            x:Name="BucketNameBox"
                                            Header="Bucket name"
                                            PlaceholderText="Your private B2 bucket" />
                                        <TextBox
                                            x:Name="KeyIdBox"
                                            Header="Application key ID"
                                            PlaceholderText="Key ID" />
                                        <PasswordBox
                                            x:Name="ApplicationKeyBox"
                                            Header="Application key"
                                            PlaceholderText="Application key"
                                            PasswordRevealMode="Peek" />
                                        <settings:SettingsExpander
                                            x:Name="ConnectionOptions"
                                            Header="Advanced connection">
                                            <settings:SettingsExpander.HeaderIcon>
                                                <FontIcon Glyph="" />
                                            </settings:SettingsExpander.HeaderIcon>
                                            <settings:SettingsExpander.Items>
                                                <settings:SettingsCard
                                                    Header="CloudBay folder on this PC"
                                                    ContentAlignment="Vertical"
                                                    HorizontalContentAlignment="Stretch">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="RootPathBox" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Content="Browse…"
                                                            Click="ChooseRoot_Click" />
                                                    </Grid>
                                                </settings:SettingsCard>
                                                <settings:SettingsCard
                                                    Header="Folder prefix in B2"
                                                    Description="Use a dedicated prefix for CloudBay files."
                                                    ContentAlignment="Vertical"
                                                    HorizontalContentAlignment="Stretch">
                                                    <TextBox x:Name="PrefixBox" />
                                                </settings:SettingsCard>
                                                <settings:SettingsCard
                                                    Header="Disconnect account"
                                                    Description="Download your files and restore Windows folder locations."
                                                    x:Name="DisconnectAccountCard">
                                                    <Button
                                                        x:Name="DisconnectButton"
                                                        Content="Disconnect"
                                                        Click="Disconnect_Click"
                                                        Visibility="Collapsed" />
                                                </settings:SettingsCard>
                                            </settings:SettingsExpander.Items>
                                        </settings:SettingsExpander>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ConnectButton"
                                                Content="Connect account"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="Connect_Click" />
                                            <Button
                                                x:Name="CancelConnectionButton"
                                                Content="Cancel"
                                                Click="CancelConnection_Click"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="SyncSettingsDetail" Spacing="4" Visibility="Collapsed">
                                <settings:SettingsCard
                                    Header="Files on demand"
                                    Description="Download files when you open them.">
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        x:Name="FilesOnDemandSwitch"
                                        Style="{StaticResource CloudBayToggleStyle}"
                                        AutomationProperties.Name="Files on demand"
                                        Toggled="Preference_Toggled" />
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    Header="Downloaded file space"
                                    Description="Windows Storage Sense manages downloaded files.">
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <Button Content="Storage Sense" Click="StorageSense_Click" />
                                </settings:SettingsCard>
                                <settings:SettingsExpander
                                    x:Name="ExclusionsExpander"
                                    Header="Excluded files and folders"
                                    Description="Matching files stay local and are not backed up.">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            Header="One name or pattern per line"
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBox
                                                    x:Name="ExclusionsBox"
                                                    AcceptsReturn="True"
                                                    MinHeight="120"
                                                    TextWrapping="Wrap"
                                                    PlaceholderText="node_modules&#10;*.tmp" />
                                                <Button
                                                    Content="Apply exclusions"
                                                    Click="ApplyExclusions_Click"
                                                    Margin="0,12,0,0" />
                                            </StackPanel>
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>
                            <StackPanel x:Name="NetworkSettingsDetail" Spacing="4" Visibility="Collapsed">
                                <settings:SettingsCard
                                    Header="Metered connections"
                                    Description="Pause syncing to limit mobile data use.">
                                    <ToggleSwitch
                                        x:Name="MeteredBox"
                                        Style="{StaticResource CloudBayToggleStyle}"
                                        AutomationProperties.Name="Pause on metered connections"
                                        Toggled="Preference_Toggled" />
                                </settings:SettingsCard>
                                <settings:SettingsCard
                                    Header="Battery Saver"
                                    Description="Pause syncing while Battery Saver is on.">
                                    <ToggleSwitch
                                        x:Name="BatterySaverBox"
                                        Style="{StaticResource CloudBayToggleStyle}"
                                        AutomationProperties.Name="Pause with Battery Saver"
                                        Toggled="Preference_Toggled" />
                                </settings:SettingsCard>
                                <settings:SettingsExpander
                                    x:Name="NetworkSettingsExpander"
                                    Header="Bandwidth limits"
                                    Description="Control transfer speed and concurrent uploads.">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            Header="Upload limit"
                                            Description="KiB/s · 0 means unlimited">
                                            <NumberBox
                                                x:Name="UploadLimitBox"
                                                Width="200"
                                                Minimum="0"
                                                Maximum="1048576"
                                                SmallChange="64"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="Disabled" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            Header="Download limit"
                                            Description="KiB/s · 0 means unlimited">
                                            <NumberBox
                                                x:Name="DownloadLimitBox"
                                                Width="200"
                                                Minimum="0"
                                                Maximum="1048576"
                                                SmallChange="64"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="Disabled" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Concurrent uploads">
                                            <NumberBox
                                                x:Name="ConcurrencyBox"
                                                Width="200"
                                                Minimum="1"
                                                Maximum="16"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="Disabled" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard Header="Bandwidth changes">
                                            <Button Content="Apply limits" Click="ApplyNetwork_Click" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>
                            <StackPanel x:Name="AppearanceSettingsDetail" Spacing="4" Visibility="Collapsed">
                                <settings:SettingsCard Header="Appearance" Description="Choose how CloudBay looks.">
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <ComboBox
                                        x:Name="ThemeBox"
                                        Width="220"
                                        SelectionChanged="Theme_SelectionChanged">
                                        <ComboBoxItem Content="Use system setting" Tag="System" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                    </ComboBox>
                                </settings:SettingsCard>
                            </StackPanel>
                            <StackPanel x:Name="GeneralSettingsDetail" Spacing="4" Visibility="Collapsed">
                                <settings:SettingsCard
                                    Header="Start at sign-in"
                                    Description="Keep CloudBay working in the background."
                                    x:Name="StartupSettingsCard">
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        x:Name="StartAtSignInBox"
                                        Style="{StaticResource CloudBayToggleStyle}"
                                        AutomationProperties.Name="Start CloudBay when I sign in"
                                        Toggled="Preference_Toggled" />
                                </settings:SettingsCard>
                            </StackPanel>
                            <StackPanel x:Name="AboutSettingsDetail" Spacing="4" Visibility="Collapsed">
                                <settings:SettingsCard
                                    Header="Providers and modes"
                                    Description="Backblaze B2 and Native backup are available now."
                                    IsClickEnabled="True"
                                    Click="Catalog_Click">
                                    <settings:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsCard.HeaderIcon>
                                </settings:SettingsCard>
                                <settings:SettingsExpander Header="CloudBay" Description="Version 2.0.0">
                                    <settings:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </settings:SettingsExpander.HeaderIcon>
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            Header="Diagnostics"
                                            Description="Open local diagnostics and activity logs.">
                                            <Button Content="Open diagnostics" Click="Diagnostics_Click" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="BusyFooter" Grid.Row="2" Padding="32,12" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" />
                    <TextBlock
                        x:Name="FooterStatus"
                        Grid.Column="1"
                        Style="{StaticResource CloudBaySecondaryTextStyle}"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </NavigationView>
        <ContentDialog
            x:Name="CatalogDialog"
            Grid.RowSpan="2"
            Title="Providers and modes"
            CloseButtonText="Done"
            DefaultButton="Close">
            <Grid RowSpacing="16" MinWidth="300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Backblaze B2 and Native backup are available now. Coming soon entries preview future releases."
                    Style="{StaticResource CloudBaySecondaryTextStyle}" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="CatalogKind"
                        Header="Browse"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="CatalogFilter_Changed">
                        <ComboBoxItem Content="Providers" />
                        <ComboBoxItem Content="Modes" />
                    </ComboBox>
                    <ComboBox
                        x:Name="CatalogGroup"
                        Grid.Column="1"
                        Header="Category"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="CatalogFilter_Changed" />
                </Grid>
                <AutoSuggestBox
                    x:Name="CatalogSearch"
                    Grid.Row="2"
                    PlaceholderText="Search providers"
                    QueryIcon="Find"
                    AutomationProperties.Name="Search providers and modes"
                    TextChanged="CatalogSearch_Changed" />
                <Grid Grid.Row="3">
                    <ListView
                        x:Name="CatalogList"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        HorizontalContentAlignment="Stretch"
                        MaxHeight="340"
                        MinHeight="100"
                        ItemTemplate="{StaticResource ProductOptionTemplate}" />
                    <TextBlock
                        x:Name="CatalogEmpty"
                        Text="No matching providers"
                        Style="{StaticResource CloudBaySecondaryTextStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
