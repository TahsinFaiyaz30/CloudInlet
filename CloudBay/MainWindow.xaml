<Window
    x:Class="CloudBay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="CloudBay"
                  Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/CloudBay-32.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        PaneDisplayMode="Auto"
                        CompactPaneLength="54"
                        IsPaneOpen="True"
                        AlwaysShowHeader="False"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">12,0,0,12</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="System Folders" Icon="Folder" Tag="folders" />
                <NavigationViewItem Content="Custom Links" Icon="Link" Tag="links" />
                <NavigationViewItem Content="Developer Filters" Icon="Filter" Tag="filters" />
            </NavigationView.MenuItems>

            <NavigationView.PaneHeader>
                <TextBlock x:Name="PaneSectionLabel"
                           Margin="16,12,0,10"
                           Style="{StaticResource CloudBaySecondaryTextStyle}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"
                           Text="WORKSPACE" />
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <StackPanel Margin="16,8,8,12" Spacing="3">
                    <TextBlock x:Name="PaneRootLabel"
                               FontSize="11" FontWeight="SemiBold" Text="CLOUD ROOT" />
                    <TextBlock x:Name="PaneRootStatus"
                               Style="{StaticResource CloudBaySecondaryTextStyle}"
                               FontSize="11"
                               Text="{Binding RootHealth}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Border x:Name="ContentSurface"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="12,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="StatusInfoBar"
                         Margin="28,8,28,8"
                         IsClosable="True"
                         IsOpen="{Binding IsAlertOpen, Mode=TwoWay}"
                         Title="{Binding AlertTitle}"
                         Message="{Binding AlertMessage}"
                         Severity="{Binding AlertSeverity}" />

                <ContentControl x:Name="PageHost"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </ContentControl.ContentTransitions>
                </ContentControl>

                <Grid Grid.Row="2" MinHeight="36" Padding="28,4,28,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="{Binding BusyMessage}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{StaticResource CloudBaySecondaryTextStyle}"
                               Text="{Binding LastRefreshText}" />
                    <ProgressBar Grid.ColumnSpan="3"
                                 Height="3"
                                 VerticalAlignment="Top"
                                 Margin="0,-4,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Opacity="{Binding ProgressOpacity}" />
                </Grid>
            </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
